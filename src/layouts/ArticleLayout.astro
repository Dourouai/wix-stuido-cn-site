---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';

interface TocItem {
  id: string;
  title: string;
}

interface NavArticle {
  title: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  keywords?: string;
  category: string;
  categorySlug: string;
  readTime?: string;
  publishDate?: string;
  heroImage?: string;
  toc?: TocItem[];
  prevArticle?: NavArticle;
  nextArticle?: NavArticle;
}

const {
  title,
  description,
  keywords,
  category,
  categorySlug,
  readTime = '8 分钟',
  publishDate = '2026-09',
  heroImage,
  toc = [],
  prevArticle,
  nextArticle,
} = Astro.props;
---

<BaseLayout
  title={`${title} | Wix Studio 中文学习平台 - wixstudio.cn`}
  description={description}
  keywords={keywords}
  type="article"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-8 overflow-x-auto whitespace-nowrap">
      <a href="/" class="hover:text-slate-900 transition flex items-center gap-1">
        <span>首页</span>
      </a>
      <span>/</span>
      {categorySlug.startsWith('/blog') ? (
        <a href="/blog/" class="hover:text-slate-900 transition">博客资讯</a>
      ) : (
        <a href="/tutorials/" class="hover:text-slate-900 transition">教程中心</a>
      )}
      <span>/</span>
      <a href={categorySlug} class="hover:text-slate-900 transition">{category}</a>
      <span>/</span>
      <span class="text-slate-900 font-medium truncate max-w-xs">{title}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <!-- Left Sticky Sidebar (Desktop TOC & Official Legend Authority) -->
      <aside class="hidden lg:block lg:col-span-3 sticky top-24 space-y-6">
        <!-- Table of Contents -->
        {toc.length > 0 && (
          <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs space-y-3.5">
            <div class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center gap-2">
              <Icon name="file-text" class="w-3.5 h-3.5 text-[#6D28D9]" />
              <span>本篇目录 CONTENTS</span>
            </div>
            <nav class="space-y-1 text-xs">
              {toc.map((item) => (
                <a
                  href={`#${item.id}`}
                  class="block py-1.5 px-2 rounded-lg text-slate-600 hover:text-[#6D28D9] hover:bg-purple-50/50 transition truncate font-medium"
                >
                  {item.title}
                </a>
              ))}
            </nav>
          </div>
        )}

        <!-- Official Legend Certification Authority Widget -->
        <div class="bg-gradient-to-br from-purple-50/60 via-white to-indigo-50/40 rounded-2xl p-5 border border-purple-200/80 shadow-xs space-y-4">
          <div class="flex items-center gap-3">
            <img
              src="/assets/badges/wix-partner-legend-200.png"
              alt="Wix Partner Legend 官方最高级别合作伙伴"
              class="w-12 h-12 object-contain shrink-0"
              loading="lazy"
            />
            <div>
              <div class="text-xs font-bold text-slate-900">Wix Partner Legend</div>
              <div class="text-[11px] text-[#6D28D9] font-medium">官方最高级别认证团队</div>
            </div>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            本文内容由 Wix 官方认证 Legend 级专家亲测沉淀，杜绝搬运误导，直击外贸建站核心交付要点。
          </p>
          <div class="pt-1 border-t border-purple-100">
            <a
              href="/contact/"
              class="text-xs font-bold text-[#6D28D9] hover:text-[#4C1D95] flex items-center justify-between group transition"
            >
              <span>委托建站评估需求</span>
              <Icon name="arrow-right" class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
            </a>
          </div>
        </div>
      </aside>

      <!-- Main Article Column -->
      <article class="lg:col-span-9 space-y-8">
        <!-- Article Header -->
        <header class="space-y-4 pb-6 border-b border-slate-200">
          <div class="flex flex-wrap items-center gap-2">
            <a
              href={categorySlug}
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-purple-50 text-[#6D28D9] text-xs font-bold border border-purple-200/70"
            >
              <Icon name="book-open" class="w-3.5 h-3.5" />
              <span>{category}</span>
            </a>
            <span class="text-xs text-slate-400">•</span>
            <span class="text-xs text-slate-500">更新时间：{publishDate}</span>
            <span class="text-xs text-slate-400">•</span>
            <span class="text-xs text-slate-500">阅读时长约 {readTime}</span>
          </div>

          <h1 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight leading-tight">
            {title}
          </h1>

          <p class="text-base text-slate-600 leading-relaxed">
            {description}
          </p>
        </header>

        <!-- Article Featured Hero Image -->
        {heroImage && (
          <div class="relative w-full h-64 sm:h-96 rounded-2xl overflow-hidden bg-slate-100 border border-slate-200/90 shadow-sm group">
            <img
              src={heroImage}
              alt={title}
              class="w-full h-full object-cover object-center group-hover:scale-102 transition-transform duration-500"
              loading="eager"
            />
          </div>
        )}

        <!-- Article Content Slot -->
        <div class="prose prose-slate max-w-none space-y-8 text-slate-700 leading-relaxed">
          <slot />
        </div>

        <!-- Article Navigation (Prev / Next) -->
        {(prevArticle || nextArticle) && (
          <div class="pt-8 border-t border-slate-200 grid grid-cols-1 sm:grid-cols-2 gap-4">
            {prevArticle ? (
              <a
                href={prevArticle.href}
                class="p-4 rounded-xl border border-slate-200 hover:border-purple-300 hover:bg-purple-50/20 transition flex flex-col space-y-1 group"
              >
                <div class="text-[11px] font-semibold text-slate-400 flex items-center gap-1">
                  <Icon name="arrow-left" class="w-3 h-3 group-hover:-translate-x-0.5 transition-transform" />
                  <span>上一篇教程</span>
                </div>
                <div class="text-sm font-bold text-slate-800 group-hover:text-[#6D28D9] transition truncate">
                  {prevArticle.title}
                </div>
              </a>
            ) : (
              <div></div>
            )}

            {nextArticle && (
              <a
                href={nextArticle.href}
                class="p-4 rounded-xl border border-slate-200 hover:border-purple-300 hover:bg-purple-50/20 transition flex flex-col space-y-1 sm:text-right group"
              >
                <div class="text-[11px] font-semibold text-slate-400 flex items-center justify-end gap-1">
                  <span>下一篇教程</span>
                  <Icon name="arrow-right" class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" />
                </div>
                <div class="text-sm font-bold text-slate-800 group-hover:text-[#6D28D9] transition truncate">
                  {nextArticle.title}
                </div>
              </a>
            )}
          </div>
        )}

        <!-- In-Article Fixed High-Converting CTA Card -->
        <div class="rounded-3xl p-8 sm:p-10 border border-purple-200/90 bg-gradient-to-br from-purple-50/70 via-white to-blue-50/50 shadow-xl shadow-purple-500/5 relative overflow-hidden space-y-6">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 relative z-10">
            <div class="space-y-2 max-w-xl">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-100/70 text-[#6D28D9] text-xs font-bold border border-purple-200">
                <Icon name="shield-check" class="w-3.5 h-3.5" />
                <span>Wix Partner Legend 官方认证团队服务</span>
              </div>
              <h3 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
                自己摸索耗费时间？交给我们，5-10 天极速交付
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                无论是高质感外贸品牌官网、全响应式流体企业独立站，还是 Velo 动态数据系统对接。我们提供从原型设计、流体开发、海外支付配置到上线运维的一站式全案落地服务。
              </p>
            </div>
            <a
              href="/contact/"
              class="btn-vibrant-glow shrink-0 px-6 py-3.5 rounded-full text-xs sm:text-sm font-bold text-white shadow-lg inline-flex items-center gap-2 hover:scale-102 active:scale-98 transition"
            >
              <span>委托建站咨询与评估</span>
              <Icon name="arrow-right" class="w-4 h-4" />
            </a>
          </div>
        </div>
      </article>
    </div>
  </div>
</BaseLayout>
