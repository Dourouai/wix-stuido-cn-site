---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

const plans = [
  {
    name: 'Standard 基础版',
    price: '$17',
    period: '/月 (按年付)',
    desc: '适合个人博客、设计作品集及小型展示型网站。',
    features: [
      '绑定独立顶级域名',
      '无 Wix 广告',
      '免费全球 SSL 证书',
      '2 GB 媒体存储空间',
      '标准访问速度',
      '7x24 基础客服支持',
    ],
    highlight: false,
    ctaText: '选择基础版',
  },
  {
    name: 'Plus 专业进阶版',
    price: '$29',
    period: '/月 (按年付)',
    desc: '最受外贸出海企业和品牌官网欢迎的明星套餐。',
    features: [
      '所有基础版权益',
      '包含标准电子商务功能 (可选)',
      '10 GB 媒体存储空间',
      '极速全球 CDN 加速',
      '支持 Velo 进阶代码与CMS',
      '优先客户服务响应',
    ],
    highlight: true,
    badge: 'MOST POPULAR 推荐',
    ctaText: '首选专业版',
  },
  {
    name: 'Elite 旗舰旗舰版',
    price: '$159',
    period: '/月 (按年付)',
    desc: '高流量出海品牌、大型商企与高并发业务专属。',
    features: [
      '所有进阶版权益',
      '无限媒体云存储空间',
      '最高级别企业基础设施支持',
      '专属客户成功经理与技术热线',
      '高级定制数据分析报表',
      '支持自定义代码性能保障',
    ],
    highlight: false,
    ctaText: '咨询旗舰方案',
  },
];

const extraCosts = [
  {
    title: '独立域名年费',
    cost: '约 60 - 100 元 / 年',
    desc: '推荐在阿里云、腾讯云或 Namecheap 购买 .com 域名，并通过 DNS CNAME 记录直接解析到 Wix Studio。',
  },
  {
    title: '企业企业邮箱',
    cost: '免费 或 约 30 元 / 用户 / 月',
    desc: '出海建站建议配置腾讯企业邮（免费版）或 Google Workspace 邮箱，极大提升海外买家询盘信任度。',
  },
  {
    title: '海外支付与网关费',
    cost: '按交易抽取（约 2.9% + $0.3）',
    desc: '接入 PayPal 或 Stripe 均无月租费用，仅在买家成功下单付款时扣取标准交易手续费。',
  },
];
---

<BaseLayout
  title="Wix Studio 价格详解（2025最新）| 套餐费用与选购指南 - wixstudio.cn"
  description="详细解析 Wix Studio 2025 最新套餐价格表，包含 Standard、Plus、Elite 各版本费用差异，外贸建站隐性成本说明，以及自建与定制建站成本对比。"
  keywords="Wix 价格, Wix Studio 多少钱, Wix 套餐费用, Wix 收费标准, Wix 建站成本"
>
  <!-- Pricing Hero -->
  <section class="relative py-20 overflow-hidden text-center bg-dots-light">
    <div class="hero-glow-light opacity-60"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-purple-50 text-[#6D28D9] text-xs font-semibold border border-purple-200">
        <Icon name="sparkles" class="w-3.5 h-3.5" />
        <span>PRICING & PLANS / 价格详解</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-black text-[#0F172A] tracking-tight">
        清晰透明的 <span class="text-gradient-brand">Wix Studio 套餐价格</span>
      </h1>
      <p class="text-base sm:text-lg text-gray-600 max-w-2xl mx-auto">
        无论是自学建站购买官方订阅，还是委托我们定制高品质外贸官网，均享有全球顶级基础设施保障。
      </p>
    </div>
  </section>

  <!-- Pricing Cards Grid in Crisp Light Theme -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {plans.map((plan) => (
        <div
          class={`light-card p-8 flex flex-col justify-between relative ${
            plan.highlight
              ? 'border-2 border-[#6D28D9] shadow-2xl shadow-purple-500/10 bg-gradient-to-b from-purple-50/30 to-white'
              : 'border-gray-200'
          }`}
        >
          {plan.badge && (
            <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-gradient-to-r from-[#6D28D9] to-[#2563EB] text-[11px] font-bold tracking-wider text-white shadow-md">
              {plan.badge}
            </div>
          )}

          <div class="space-y-6">
            <div>
              <h3 class="text-xl font-bold text-[#0F172A]">{plan.name}</h3>
              <p class="text-xs text-gray-500 mt-1.5 min-h-[32px]">{plan.desc}</p>
            </div>

            <div class="flex items-baseline gap-1">
              <span class="text-4xl sm:text-5xl font-black text-[#0F172A] tracking-tight">{plan.price}</span>
              <span class="text-xs text-gray-400">{plan.period}</span>
            </div>

            <div class="pt-6 border-t border-gray-100 space-y-3">
              <div class="text-xs font-semibold uppercase tracking-wider text-gray-400">包含核心权益：</div>
              <ul class="space-y-2.5 text-sm text-gray-700">
                {plan.features.map((feat) => (
                  <li class="flex items-start gap-2.5">
                    <Icon name="check" class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="pt-8">
            <a
              href="/contact/"
              class={`w-full py-3 rounded-full text-sm font-semibold flex items-center justify-center transition ${
                plan.highlight
                  ? 'btn-primary-glow bg-gradient-to-r from-[#6D28D9] to-[#2563EB] text-white shadow-md'
                  : 'bg-gray-100 text-gray-800 hover:bg-gray-200/80 border border-gray-200'
              }`}
            >
              {plan.ctaText}
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Extra Cost Breakdown -->
  <section class="py-16 bg-[#F8FAFC] border-y border-gray-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="text-center space-y-2">
        <h2 class="text-2xl sm:text-3xl font-bold text-[#0F172A]">建站涉及的其它费用明细（隐性成本说明）</h2>
        <p class="text-sm text-gray-600">拒绝隐形套路，做有良心的建站指引</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {extraCosts.map((item) => (
          <div class="light-card p-6 space-y-2 border border-gray-200">
            <h3 class="text-base font-bold text-[#0F172A]">{item.title}</h3>
            <div class="text-sm font-semibold text-[#6D28D9]">{item.cost}</div>
            <p class="text-xs text-gray-500 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Build by Yourself vs Agent Customization -->
  <section class="py-20 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="light-card p-8 sm:p-12 border-2 border-purple-200 bg-gradient-to-br from-white via-purple-50/20 to-white space-y-8 shadow-xl shadow-purple-500/5">
      <div class="text-center space-y-3">
        <div class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1 rounded-full bg-purple-100 text-[#6D28D9]">
          <Icon name="scale" class="w-3.5 h-3.5" />
          <span>DECISION MATRIX / 选型决策</span>
        </div>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-[#0F172A]">自己搭建 vs 委托我们定制</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 divide-y md:divide-y-0 md:divide-x divide-gray-200">
        <div class="space-y-4 pr-0 md:pr-4">
          <h3 class="text-lg font-bold text-[#0F172A] flex items-center gap-2">
            <Icon name="wrench" class="w-5 h-5 text-slate-700" />
            <span>自己对照教程搭建</span>
          </h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            适合有一定时间、学习能力强，且网站需求较基础的个人创作者。
          </p>
          <ul class="space-y-2 text-xs text-gray-700">
            <li class="flex items-start gap-2">
              <Icon name="check" class="w-3.5 h-3.5 text-emerald-500 shrink-0 mt-0.5" />
              <span>费用极低：仅需支付 Wix 套餐与域名年费</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon name="check" class="w-3.5 h-3.5 text-emerald-500 shrink-0 mt-0.5" />
              <span>自由掌控：随时改动与练习</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon name="x" class="w-3.5 h-3.5 text-slate-400 shrink-0 mt-0.5" />
              <span>耗费时间：需摸索排版动效与移动端适配</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon name="x" class="w-3.5 h-3.5 text-slate-400 shrink-0 mt-0.5" />
              <span>视觉上限受限：非专业设计容易造成版面失衡</span>
            </li>
          </ul>
        </div>

        <div class="space-y-4 pt-6 md:pt-0 pl-0 md:pl-8">
          <h3 class="text-lg font-bold text-[#6D28D9] flex items-center gap-2">
            <Icon name="shield-check" class="w-5 h-5 text-[#6D28D9]" />
            <span>委托 Wix Partner Legend 团队定制</span>
          </h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            适合外贸出海企业、品牌商家及对视觉和交付速度有高要求的客户。
          </p>
          <ul class="space-y-2 text-xs text-gray-700">
            <li class="flex items-start gap-2">
              <Icon name="check" class="w-3.5 h-3.5 text-emerald-500 shrink-0 mt-0.5" />
              <span>省时省力：5-15 天极速交付国际水准官网</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon name="check" class="w-3.5 h-3.5 text-emerald-500 shrink-0 mt-0.5" />
              <span>官方最高认证：深谙 Wix Studio 动效与流体引擎</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon name="check" class="w-3.5 h-3.5 text-emerald-500 shrink-0 mt-0.5" />
              <span>售后无忧：交付后提供后台修改培训与技术保障</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon name="check" class="w-3.5 h-3.5 text-emerald-500 shrink-0 mt-0.5" />
              <span>转化倍增：针对出海买家习惯优化排版与CTA</span>
            </li>
          </ul>
          <div class="pt-2">
            <a href="/contact/" class="btn-primary-glow inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full text-xs font-semibold text-white bg-gradient-to-r from-[#6D28D9] to-[#2563EB] shadow-md transition">
              <span>获取代建站服务评估报价</span>
              <Icon name="arrow-right" class="w-3.5 h-3.5" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
