---
import BaseLayout from '../../layouts/BaseLayout.astro';

const tracks = [
  {
    title: '📘 Getting Started (新手入门)',
    slug: '/tutorials/getting-started/',
    desc: '专为初次接触 Wix Studio 的用户设计。从账户创建、编辑器核心面板、流体响应式机制到发布第一个网站。',
    articles: [
      'Wix Studio 是什么？与普通经典版 Wix 的核心区别',
      '从零开始：注册账号并创建第一个空白项目',
      '深入浅出：Wix Studio 编辑器工作区全解析',
      '如何为网站绑定自己的顶级独立域名与开启 SSL',
    ],
  },
  {
    title: '🎨 Design & Layout (设计与响应式)',
    slug: '/tutorials/design/',
    desc: '从视觉设计出发，探索比例缩放（Scale Proportionally）、网格系统（Grid）、CSS 布局与微交互动效。',
    articles: [
      '流体引擎完全指南：彻底搞懂自定义断点与等比缩放',
      'CSS Grid 与 Flexbox 在 Wix Studio 中的实战运用',
      '利用微动效（Hover & Scroll Animations）提升高级质感',
      '官方 Figma to Studio 插件：设计稿一键无缝转换',
    ],
  },
  {
    title: '💻 Velo Dev (全栈开发与代码)',
    slug: '/tutorials/velo/',
    desc: '面向有编程或进阶动态数据需求的用户。掌握 JavaScript 语法、Wix CMS 数据集与第三方 API 联动。',
    articles: [
      'Velo 开发入门：前端页面元素交互与代码逻辑',
      'Wix CMS 数据库建立与动态页面（Dynamic Pages）绑定',
      '在 Wix Studio 中编写自定义 CSS 类名与全局变量',
      '调用外部 REST API 接口并在页面动态渲染数据',
    ],
  },
  {
    title: '🔍 SEO Guide (搜索引擎优化)',
    slug: '/tutorials/seo/',
    desc: '打通百度与 Google 双端搜索引擎收录逻辑。从元标签、结构化数据 Schema 到核心网页指标速度调优。',
    articles: [
      'Wix 网站 SEO 全攻略：让 Google 与百度快速抓取',
      '如何生成与提交标准 Sitemap 站点地图到各大搜索引擎',
      '页面速度性能优化：Core Web Vitals 指标全绿秘诀',
    ],
  },
  {
    title: '🛒 E-Commerce (外贸电商与出海独立站)',
    slug: '/tutorials/ecommerce/',
    desc: '专为跨境与出海商家提供。涵盖产品目录管理、PayPal / Stripe 多币种海外金流配置与运费规则。',
    articles: [
      '从零搭建跨境外贸商城：商品录入与品类规划',
      '海外支付网关接入：PayPal / Stripe 实操指南',
      '多语言（Multilingual）与多币种自动汇率切换配置',
    ],
  },
];
---

<BaseLayout
  title="Wix Studio 中文教程中心 | 从零基础入门到进阶开发指南 - wixstudio.cn"
  description="中国最系统全面的 Wix Studio 中文教程体系。提供零基础入门、流体响应式排版、Velo 代码开发、SEO优化与外贸独立站全流程指南。"
  keywords="Wix 教程, Wix Studio 教程, Wix Studio 怎么用, Wix 建站教程, Wix 中文教程, Wix Velo"
>
  <section class="relative py-20 overflow-hidden text-center">
    <div class="hero-glow-bg opacity-70"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#7C5CFC]/20 text-[#9D82FF] text-xs font-semibold">
        TUTORIAL CENTER
      </div>
      <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight">
        Wix Studio <span class="text-gradient">中文教程中心</span>
      </h1>
      <p class="text-base sm:text-lg text-white/70 max-w-2xl mx-auto">
        系统化、实战导向的课程路径。无论您是追求极致视觉的设计师，还是开拓海外市场的外贸创业者，这里都有最清晰的中文指引。
      </p>
    </div>
  </section>

  <!-- Tutorial Tracks List -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-24 space-y-8">
    {tracks.map((track) => (
      <div class="glass-card p-8 border border-white/10 hover:border-[#7C5CFC]/40 transition space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-white/[0.08]">
          <div>
            <h2 class="text-2xl font-bold text-white hover:text-[#9D82FF] transition">
              <a href={track.slug}>{track.title}</a>
            </h2>
            <p class="text-xs sm:text-sm text-white/60 mt-1">{track.desc}</p>
          </div>
          <a
            href={track.slug}
            class="shrink-0 px-4 py-2 rounded-full text-xs font-semibold text-white bg-white/10 hover:bg-[#7C5CFC] transition text-center"
          >
            进入系列专栏 →
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {track.articles.map((item, idx) => (
            <div class="p-3.5 rounded-xl bg-white/[0.02] border border-white/[0.05] hover:border-white/15 transition flex items-center gap-3">
              <span class="w-6 h-6 rounded-full bg-[#7C5CFC]/20 text-[#9D82FF] text-xs font-bold flex items-center justify-center shrink-0">
                {idx + 1}
              </span>
              <span class="text-xs sm:text-sm text-white/80 line-clamp-1">{item}</span>
            </div>
          ))}
        </div>
      </div>
    ))}
  </section>

  <!-- Learning Path Roadmap -->
  <section class="py-20 bg-[#0A0A0A] border-t border-white/[0.08]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="text-center space-y-2">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white">推荐学习路径 (Learning Path)</h2>
        <p class="text-sm text-white/60">根据您的背景，选择最适合的高效进阶路线</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="glass-card p-6 space-y-3">
          <div class="text-xs font-bold uppercase tracking-wider text-[#9D82FF]">PATH 1</div>
          <h3 class="text-lg font-bold text-white">零基础新手路线</h3>
          <div class="text-xs text-white/60 space-y-2">
            <p>1. 熟悉工作区面板与常用组件</p>
            <p>2. 掌握容器与基础布局逻辑</p>
            <p>3. 学习模板修改并绑定域名上线</p>
          </div>
        </div>

        <div class="glass-card p-6 space-y-3 border-[#7C5CFC]/40">
          <div class="text-xs font-bold uppercase tracking-wider text-emerald-400">PATH 2 (推荐)</div>
          <h3 class="text-lg font-bold text-white">设计师接单进阶</h3>
          <div class="text-xs text-white/60 space-y-2">
            <p>1. 深入理解流体断点与比例缩放</p>
            <p>2. 熟练运用 Figma 转换插件</p>
            <p>3. 打造高级悬停微动效与交付体系</p>
          </div>
        </div>

        <div class="glass-card p-6 space-y-3">
          <div class="text-xs font-bold uppercase tracking-wider text-[#4A90E2]">PATH 3</div>
          <h3 class="text-lg font-bold text-white">全栈与商业定制</h3>
          <div class="text-xs text-white/60 space-y-2">
            <p>1. 学习 Velo JavaScript 事件与API</p>
            <p>2. 构建 CMS 数据库与动态列表</p>
            <p>3. 整合海外第三方支付与工作流</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
