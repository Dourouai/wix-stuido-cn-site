---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';

const chapters = [
  {
    order: '01',
    title: 'Wix Studio 是什么？与普通经典版 Wix 的核心区别全解析',
    desc: '从底层流体引擎、现代 CSS 控制、全栈 Velo 开发到团队权限隔离，全面对比两代产品本质差异。',
    href: '/tutorials/getting-started/what-is-wix-studio/',
    readTime: '10 分钟',
    tag: '基础认知',
  },
  {
    order: '02',
    title: '从零开始：Wix Studio 账号注册与团队工作空间初始化',
    desc: '国内邮箱选型避坑、Agency Workspace 建立、团队角色细粒度分配以及客户防破坏锁定机制。',
    href: '/tutorials/getting-started/account-setup/',
    readTime: '8 分钟',
    tag: '环境配置',
  },
  {
    order: '03',
    title: '深入浅出：Wix Studio 工作台与核心工具面板完全图解',
    desc: '断点标尺条、左侧元素库、右侧属性检查器与图层 DOM 嵌套树深度图解，掌握流体缩放核心命脉。',
    href: '/tutorials/getting-started/editor-walkthrough/',
    readTime: '12 分钟',
    tag: '核心操作',
  },
  {
    order: '04',
    title: '域名绑定与解析完全指南：从阿里云/腾讯云到 Wix Studio',
    desc: '出海域名选型建议、指向解析（Pointing）CNAME/A 记录配置实操、免费自动签发全球 SSL 证书。',
    href: '/tutorials/getting-started/connect-domain/',
    readTime: '9 分钟',
    tag: '上线部署',
  },
];
---

<BaseLayout
  title="Wix Studio 新手入门完全实战专栏（从零到发布）- wixstudio.cn"
  description="面向零基础建站者的 Wix Studio 入门系列课程。系统化讲解平台特性认知、工作区搭建、编辑器操作流体缩放技巧与顶级域名绑定全流程。"
  keywords="Wix Studio 怎么用, Wix Studio 入门教程, Wix Studio 新手, Wix 建站全流程, Wix Studio 教学"
>
  <!-- Track Hero Header -->
  <section class="relative py-16 sm:py-20 overflow-hidden text-center bg-dots-light">
    <div class="hero-glow-light opacity-60"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 space-y-4">
      <nav class="flex justify-center items-center gap-2 text-xs text-slate-500 mb-2">
        <a href="/" class="hover:text-slate-900 transition">首页</a>
        <span>/</span>
        <a href="/tutorials/" class="hover:text-slate-900 transition">教程中心</a>
        <span>/</span>
        <span class="text-slate-900 font-medium">新手入门实战</span>
      </nav>

      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-purple-50 text-[#6D28D9] text-xs font-bold border border-purple-200">
        <Icon name="book-open" class="w-3.5 h-3.5" />
        <span>BEGINNER TRACK / 新手入门实战</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
        Wix Studio <span class="text-gradient-brand">新手入门系统教程</span>
      </h1>

      <p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        由浅入深，4 篇深度图文带您从零基础小白蜕变为精通流体排版与网站发布的出海建站能手。
      </p>
    </div>
  </section>

  <!-- Track Chapters List -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-20 space-y-6">
    <div class="flex items-center justify-between pb-4 border-b border-slate-200">
      <div class="text-sm font-bold text-slate-900">专栏章节列表（共 4 篇精编长文）</div>
      <div class="text-xs text-slate-500">累计阅读约 40 分钟</div>
    </div>

    <div class="space-y-4">
      {chapters.map((item) => (
        <a
          href={item.href}
          class="block p-6 sm:p-7 rounded-2xl bg-white border border-slate-200 hover:border-purple-300 hover:shadow-lg hover:shadow-purple-500/5 transition group"
        >
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-start gap-4">
              <span class="w-10 h-10 rounded-xl bg-purple-50 text-[#6D28D9] font-black text-sm flex items-center justify-center shrink-0 border border-purple-200/60 group-hover:bg-[#6D28D9] group-hover:text-white transition">
                {item.order}
              </span>
              <div class="space-y-1.5">
                <div class="flex items-center gap-2">
                  <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-slate-100 text-slate-600">
                    {item.tag}
                  </span>
                  <span class="text-[11px] text-slate-400">阅读约 {item.readTime}</span>
                </div>
                <h2 class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-[#6D28D9] transition">
                  {item.title}
                </h2>
                <p class="text-xs sm:text-sm text-slate-500 line-clamp-2 leading-relaxed">
                  {item.desc}
                </p>
              </div>
            </div>

            <div class="shrink-0 flex sm:flex-col items-center sm:items-end justify-between text-xs font-bold text-[#6D28D9] group-hover:translate-x-1 transition-transform">
              <span class="flex items-center gap-1">
                <span>阅读文章</span>
                <Icon name="arrow-right" class="w-3.5 h-3.5" />
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Official Authority & Service CTA Card -->
    <div class="rounded-3xl p-8 sm:p-10 border border-purple-200/90 bg-gradient-to-br from-purple-50/70 via-white to-blue-50/50 shadow-xl shadow-purple-500/5 space-y-6 mt-12">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div class="space-y-2 max-w-xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-100/70 text-[#6D28D9] text-xs font-bold border border-purple-200">
            <Icon name="shield-check" class="w-3.5 h-3.5" />
            <span>Wix Partner Legend 官方认证团队服务</span>
          </div>
          <h3 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
            看完教程需要更多时间，或想直接拥有顶级官网？
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            将您的企业外贸出海或品牌官网托付给我们。由官方最高认证专家团队亲自操刀，5-10 天极速交付国际水准官网，附赠后台维护培训与长期技术支持。
          </p>
        </div>
        <a
          href="/contact/"
          class="btn-vibrant-glow shrink-0 px-6 py-3.5 rounded-full text-xs sm:text-sm font-bold text-white shadow-lg inline-flex items-center gap-2 hover:scale-102 active:scale-98 transition"
        >
          <span>委托建站咨询与评估</span>
          <Icon name="arrow-right" class="w-4 h-4" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
