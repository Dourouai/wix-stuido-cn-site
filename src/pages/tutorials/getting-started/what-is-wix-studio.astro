---
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import Icon from '../../../components/Icon.astro';

const toc = [
  { id: 'summary', title: '30秒核心速览 (Executive Summary)' },
  { id: 'definition', title: '1. 什么是 Wix Studio？核心架构与定位' },
  { id: 'differences', title: '2. 与经典版 Wix 的 6 大代际差异对比' },
  { id: 'fluid-engine', title: '3. 核心机制：等比流体缩放引擎 (Scale Proportionally)' },
  { id: 'who-should-use', title: '4. 哪些出海团队应该立即采用？' },
  { id: 'action-plan', title: '5. 保姆级新手起步四步实战指引' },
  { id: 'pitfalls', title: '6. 常见认知误区与避坑指南' },
  { id: 'official-references', title: '7. Wix 官方 Support 权威参考文档' },
  { id: 'faq', title: '8. 高频常见问题解答 (FAQ)' },
];

const compareTable = [
  { feature: '目标客群', classic: '个人博主、小白商户、轻量微型展示', studio: '专业网页设计师、外贸出海企业、全栈技术代理商' },
  { feature: '响应式引擎', classic: '仅支持桌面与移动双视口手动重排（容易拉伸错位）', studio: '等比流体缩放（Fluid Engine）+ 无限自定义屏幕断点' },
  { feature: 'CSS 掌控力', classic: '完全封闭黑盒，无法编写或覆盖原生样式', studio: '支持 CSS Grid、Flexbox 弹性盒模型与原生自定义 CSS' },
  { feature: '代码与数据库', classic: '仅提供基础嵌入式 HTML 代码块', studio: '内置完整 Velo IDE、无服务器服务端函数与 CMS 关系型数据库' },
  { feature: '团队与客户模式', classic: '仅基础管理员角色分享，容易误删误改', studio: '画布级批注讨论、精细化客户内容锁（Client Mode 防破版）' },
  { feature: 'Figma 联动工作流', classic: '需人工手动逐一切图重构', studio: '官方 Figma to Studio 插件一键转换无损响应式网页' },
];

const officialDocs = [
  {
    title: 'Wix Studio: About Wix Studio',
    desc: 'Wix 官方对 Studio 核心平台架构、适用人群及生态演进的全面阐述。',
    url: 'https://support.wix.com/en/article/wix-studio-about-wix-studio',
  },
  {
    title: 'Wix Studio: Comparing the Studio Editor to the Wix Editor',
    desc: '官方技术团队从排版引擎、断点管理到代码支持维度的代际差异对照表。',
    url: 'https://support.wix.com/en/article/wix-studio-comparing-the-studio-editor-to-the-wix-editor',
  },
  {
    title: 'Wix Studio: Responsive Behaviors Overview',
    desc: '系统学习 Scale Proportionally、Fixed、Fluid 等核心响应式行为的官方指引。',
    url: 'https://support.wix.com/en/article/wix-studio-responsive-behaviors',
  },
];
---

<ArticleLayout
  title="Wix Studio 是什么？与普通经典版 Wix 的核心区别全解析"
  description="深度拆解什么是 Wix Studio。从流体响应式引擎、CSS底层支持、全栈 Velo 开发到团队权限隔离，全面对比普通经典版 Wix，并附官方 Wix Support 原厂文档指引。"
  keywords="Wix Studio 是什么, Wix Studio 和 Wix 区别, Wix 经典版, Wix Studio 测评, 外贸建站选型, Wix Support"
  category="新手入门实战"
  categorySlug="/tutorials/getting-started/"
  readTime="10 分钟"
  publishDate="2026-09-20"
  heroImage="/assets/images/tutorial-featured-cover.jpg"
  toc={toc}
  nextArticle={{
    title: "从零开始：Wix Studio 账号注册与团队工作空间初始化",
    href: "/tutorials/getting-started/account-setup/",
  }}
>
  <!-- 30s Executive Summary -->
  <section id="summary" class="bg-gradient-to-br from-blue-50/80 via-white to-indigo-50/50 p-6 sm:p-8 rounded-2xl border border-blue-200/80 shadow-xs space-y-3">
    <div class="flex items-center gap-2 text-[#116DFF] text-xs font-bold uppercase tracking-wider">
      <Icon name="sparkles" class="w-4 h-4" />
      <span>30秒核心速览 (Executive Summary)</span>
    </div>
    <p class="text-sm sm:text-base text-slate-800 leading-relaxed font-medium">
      <strong class="text-slate-900 font-bold">一句话定义：</strong> Wix Studio 是 Wix 官方专为自由设计师、外贸出海企业与数字营销机构打造的<strong>新一代专业级 Web 创建操作系统</strong>。
    </p>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2 text-xs">
      <div class="p-3 bg-white rounded-xl border border-slate-200/70">
        <span class="text-slate-400 block mb-1">预计掌握耗时</span>
        <span class="font-bold text-slate-800">10 分钟研读</span>
      </div>
      <div class="p-3 bg-white rounded-xl border border-slate-200/70">
        <span class="text-slate-400 block mb-1">技术要求</span>
        <span class="font-bold text-slate-800">零代码基础</span>
      </div>
      <div class="p-3 bg-white rounded-xl border border-slate-200/70">
        <span class="text-slate-400 block mb-1">核心突破</span>
        <span class="font-bold text-[#116DFF]">等比流体缩放</span>
      </div>
      <div class="p-3 bg-white rounded-xl border border-slate-200/70">
        <span class="text-slate-400 block mb-1">参考源头</span>
        <span class="font-bold text-emerald-600">Wix Support 官方</span>
      </div>
    </div>
  </section>

  <!-- Section 1: Definition -->
  <section id="definition" class="space-y-4">
    <h2 class="text-xl sm:text-2xl font-bold text-slate-900 flex items-center gap-2">
      <span class="w-2 h-6 bg-[#116DFF] rounded-full inline-block"></span>
      <span>1. 什么是 Wix Studio？核心架构与定位</span>
    </h2>
    <p>
      长久以来，中国出海制造企业、独立站品牌与设计师在建站工具的选择上常常陷入<strong>两难困境</strong>：
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="p-5 rounded-xl bg-slate-50 border border-slate-200 space-y-2">
        <div class="flex items-center gap-2 text-slate-700 font-bold text-sm">
          <Icon name="x" class="w-4 h-4 text-rose-500" />
          <span>普通 SaaS 模板建站（如旧版 Wix / Shopify 模板）</span>
        </div>
        <p class="text-xs text-slate-500 leading-relaxed">
          虽然易于上手，但排版受限。一旦遇到超宽带鱼屏或小屏轻薄本，元素极其容易重叠拉伸或留下大块难看的空白，无法体现一线品牌的高级视觉。
        </p>
      </div>
      <div class="p-5 rounded-xl bg-slate-50 border border-slate-200 space-y-2">
        <div class="flex items-center gap-2 text-slate-700 font-bold text-sm">
          <Icon name="x" class="w-4 h-4 text-rose-500" />
          <span>开源底层自建（如 WordPress + Elementor）</span>
        </div>
        <p class="text-xs text-slate-500 leading-relaxed">
          虽然看似自由，但需要自建 Linux 服务器、配置 MySQL 与 PHP，且重度依赖第三方插件。安全挂马、版本冲突白屏的持续运维成本极其昂贵。
        </p>
      </div>
    </div>
    <p>
      <strong>Wix Studio</strong> 诞生于 2023 年末并在 2026 年全面演进至 2.0。它完美结合了<strong>云端 SaaS 的免运维安全底层</strong>与<strong>专业设计工具（如 Figma / Webflow）的像素级自由度</strong>。
    </p>
  </section>

  <!-- Section 2: Comparison Table -->
  <section id="differences" class="space-y-4">
    <h2 class="text-xl sm:text-2xl font-bold text-slate-900 flex items-center gap-2">
      <span class="w-2 h-6 bg-[#116DFF] rounded-full inline-block"></span>
      <span>2. 与普通经典版 Wix 的 6 大代际差异对比</span>
    </h2>
    <p>
      初学者最常见的问题是：“我已经在用普通 Wix 了，还有必要转向 Wix Studio 吗？”下表为您提炼两者根本性的代际差异：
    </p>

    <div class="overflow-x-auto rounded-2xl border border-slate-200 shadow-xs">
      <table class="w-full text-left text-xs sm:text-sm">
        <thead class="bg-slate-50 border-b border-slate-200 text-slate-900 font-bold">
          <tr>
            <th class="p-4 w-1/4">对比维度</th>
            <th class="p-4 text-slate-500 w-1/3">普通经典版 Wix (Classic Editor)</th>
            <th class="p-4 text-[#116DFF] bg-blue-50/50 w-5/12">专业旗舰版 Wix Studio</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-slate-700">
          {compareTable.map((row) => (
            <tr class="hover:bg-slate-50/80 transition">
              <td class="p-4 font-semibold text-slate-900">{row.feature}</td>
              <td class="p-4 text-slate-500">{row.classic}</td>
              <td class="p-4 font-semibold text-[#116DFF] bg-blue-50/20">{row.studio}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Section 3: Fluid Responsive Engine -->
  <section id="fluid-engine" class="space-y-4">
    <h2 class="text-xl sm:text-2xl font-bold text-slate-900 flex items-center gap-2">
      <span class="w-2 h-6 bg-[#116DFF] rounded-full inline-block"></span>
      <span>3. 核心机制：等比流体缩放引擎 (Scale Proportionally)</span>
    </h2>
    <p>
      经典版拖拽工具依靠绝对像素（px）定死位置。当视窗变宽时，元素左右留下巨大空白；变窄时文字挤压折行。
    </p>
    <p>
      Wix Studio 的核心引擎基于<strong>等比流体缩放（Scale Proportionally）</strong>：
    </p>
    <div class="p-5 rounded-2xl bg-slate-900 text-slate-100 space-y-3 font-mono text-xs">
      <div class="text-[#116DFF] font-bold flex items-center gap-2">
        <Icon name="code" class="w-4 h-4" />
        <span>// 流体等比数学公式原理</span>
      </div>
      <p class="text-slate-300 leading-relaxed">
        实际像素 = (画布设计尺寸 / 基准断点宽度) * 当前视窗动态宽度(vw)<br />
        系统自动配合 CSS <code>clamp(min, preferred_vw, max)</code> 锁定最小极值与最大保护值，防止大屏文字无限膨胀或移动端过小。
      </p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2 text-xs">
      <div class="p-4 bg-slate-50 rounded-xl border border-slate-200">
        <strong class="text-slate-900 block mb-1">大屏沉浸体验</strong>
        <span class="text-slate-500">在 2K / 4K 宽屏显示器上，画面等比延展，无突兀两边大留白。</span>
      </div>
      <div class="p-4 bg-slate-50 rounded-xl border border-slate-200">
        <strong class="text-slate-900 block mb-1">断点工作量减半</strong>
        <span class="text-slate-500">不再需要为每个笔记本单独调断点，流体引擎平滑自适应。</span>
      </div>
      <div class="p-4 bg-slate-50 rounded-xl border border-slate-200">
        <strong class="text-slate-900 block mb-1">局部精细控制</strong>
        <span class="text-slate-500">文字、卡片、按钮可混合指定为“固定大小”、“流体”或“按百分比”。</span>
      </div>
    </div>
  </section>

  <!-- Section 4: Who should use it -->
  <section id="who-should-use" class="space-y-4">
    <h2 class="text-xl sm:text-2xl font-bold text-slate-900 flex items-center gap-2">
      <span class="w-2 h-6 bg-[#116DFF] rounded-full inline-block"></span>
      <span>4. 哪些出海团队应该立即采用？</span>
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
      <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-xs space-y-2">
        <div class="w-9 h-9 rounded-xl bg-blue-50 text-[#116DFF] flex items-center justify-center">
          <Icon name="globe" class="w-5 h-5" />
        </div>
        <h3 class="font-bold text-slate-900 text-sm">外贸 B2B 制造与跨境品牌</h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          需要通过高端验厂官网树立国际买家信任，展示多语言本地化（/de/、/es/）且后续由运营人员直接维护。
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-xs space-y-2">
        <div class="w-9 h-9 rounded-xl bg-violet-50 text-violet-600 flex items-center justify-center">
          <Icon name="palette" class="w-5 h-5" />
        </div>
        <h3 class="font-bold text-slate-900 text-sm">独立设计师与建站工作室</h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          承接高客单价品牌定制网站，利用 Figma 插件一键转换响应式排版，大幅压缩交付工时并提供客户锁权限。
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-xs space-y-2">
        <div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
          <Icon name="code" class="w-5 h-5" />
        </div>
        <h3 class="font-bold text-slate-900 text-sm">全栈前端与低代码工程师</h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          厌烦重复编写响应式 CSS 盒模型，希望利用 Velo JS 专注于商业逻辑、支付 Webhook 与关系型 CMS 数据打通。
        </p>
      </div>
    </div>
  </section>

  <!-- Section 5: Action Plan -->
  <section id="action-plan" class="space-y-4">
    <h2 class="text-xl sm:text-2xl font-bold text-slate-900 flex items-center gap-2">
      <span class="w-2 h-6 bg-[#116DFF] rounded-full inline-block"></span>
      <span>5. 保姆级新手起步四步实战指引</span>
    </h2>
    <div class="space-y-3 text-xs sm:text-sm text-slate-700">
      <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 flex gap-3.5 items-start">
        <span class="w-6 h-6 rounded-full bg-[#116DFF] text-white flex items-center justify-center text-xs font-bold shrink-0">1</span>
        <div>
          <strong class="text-slate-900 block mb-0.5">注册账号并初始化团队工作空间 (Workspace)</strong>
          <span class="text-slate-500">登录 wix.com/studio 注册，建立您的机构 Workspace 并设置默认品牌色彩。</span>
        </div>
      </div>
      <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 flex gap-3.5 items-start">
        <span class="w-6 h-6 rounded-full bg-[#116DFF] text-white flex items-center justify-center text-xs font-bold shrink-0">2</span>
        <div>
          <strong class="text-slate-900 block mb-0.5">通过官方精选模板学习图层架构</strong>
          <span class="text-slate-500">不要急于在空白画布直接拖入元素。先挑选一套优秀的官方行业模板，点击检查器拆解它的 Section 与 CSS Grid 结构。</span>
        </div>
      </div>
      <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 flex gap-3.5 items-start">
        <span class="w-6 h-6 rounded-full bg-[#116DFF] text-white flex items-center justify-center text-xs font-bold shrink-0">3</span>
        <div>
          <strong class="text-slate-900 block mb-0.5">动手搭建第一个全屏 Hero 横幅</strong>
          <span class="text-slate-500">放入大标题、副文本与 CTA 按钮，拉动顶部的断点滑块，直观感受等比流体缩放的神奇效果。</span>
        </div>
      </div>
      <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 flex gap-3.5 items-start">
        <span class="w-6 h-6 rounded-full bg-[#116DFF] text-white flex items-center justify-center text-xs font-bold shrink-0">4</span>
        <div>
          <strong class="text-slate-900 block mb-0.5">完成域名解析与上线发布测试</strong>
          <span class="text-slate-500">跟随本专栏后续章节完成企业独立域名绑定，享受全自动全球 CDN 加速与免费 SSL。</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 6: Pitfalls -->
  <section id="pitfalls" class="space-y-4">
    <h2 class="text-xl sm:text-2xl font-bold text-slate-900 flex items-center gap-2">
      <span class="w-2 h-6 bg-amber-500 rounded-full inline-block"></span>
      <span>6. 常见认知误区与避坑指南</span>
    </h2>
    <div class="space-y-3">
      <div class="p-4 rounded-xl bg-amber-50/60 border border-amber-200/80 text-xs sm:text-sm text-slate-700 space-y-1">
        <div class="font-bold text-amber-900 flex items-center gap-1.5">
          <Icon name="shield-check" class="w-4 h-4 text-amber-600" />
          <span>误区 1：把 Wix Studio 当作经典版拖拽使用，忽略图层包裹</span>
        </div>
        <p class="text-slate-600 text-xs leading-relaxed">
          在 Studio 中，绝对不能将孤立文字或按钮随意扔在画布空白处。应始终遵循“Section -> Container / Grid Cell -> Element”的标准现代盒模型嵌套，否则响应式拉伸时缺乏参照父级。
        </p>
      </div>

      <div class="p-4 rounded-xl bg-amber-50/60 border border-amber-200/80 text-xs sm:text-sm text-slate-700 space-y-1">
        <div class="font-bold text-amber-900 flex items-center gap-1.5">
          <Icon name="shield-check" class="w-4 h-4 text-amber-600" />
          <span>误区 2：在移动端断点随意删除桌面端元素</span>
        </div>
        <p class="text-slate-600 text-xs leading-relaxed">
          如果您在手机端断点直接按 Delete 键删除某个元素，桌面端也会被同步删除！正确的做法是在左侧图层面板中将该元素设置为“在当前断点隐藏 (Hide on this breakpoint)”。
        </p>
      </div>
    </div>
  </section>

  <!-- Section 7: Official References -->
  <section id="official-references" class="space-y-4">
    <h2 class="text-xl sm:text-2xl font-bold text-slate-900 flex items-center gap-2">
      <span class="w-2 h-6 bg-emerald-600 rounded-full inline-block"></span>
      <span>7. Wix 官方 Support 权威参考文档</span>
    </h2>
    <p class="text-xs sm:text-sm text-slate-600">
      本篇实战内容严格对齐 Wix 原厂官方技术文档。如需深入研读英文原版规格说明，推荐查阅以下 Wix Help Center 官方链接：
    </p>
    <div class="grid grid-cols-1 gap-3 pt-1">
      {officialDocs.map((doc) => (
        <a
          href={doc.url}
          target="_blank"
          rel="noopener noreferrer"
          class="p-4 rounded-xl bg-white border border-slate-200 hover:border-[#116DFF] hover:shadow-xs transition group flex items-start justify-between gap-4"
        >
          <div class="space-y-1">
            <div class="text-sm font-bold text-slate-900 group-hover:text-[#116DFF] flex items-center gap-1.5">
              <span>{doc.title}</span>
              <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-blue-50 text-[#116DFF]">Official Support</span>
            </div>
            <p class="text-xs text-slate-500 leading-relaxed">{doc.desc}</p>
          </div>
          <Icon name="chevron-right" class="w-4 h-4 text-slate-400 group-hover:text-[#116DFF] shrink-0 mt-1 transition-transform group-hover:translate-x-1" />
        </a>
      ))}
    </div>
  </section>

  <!-- Section 8: FAQ -->
  <section id="faq" class="space-y-4">
    <h2 class="text-xl sm:text-2xl font-bold text-slate-900 flex items-center gap-2">
      <span class="w-2 h-6 bg-indigo-600 rounded-full inline-block"></span>
      <span>8. 高频常见问题解答 (FAQ)</span>
    </h2>
    <div class="space-y-3">
      <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 text-xs sm:text-sm space-y-1">
        <strong class="text-slate-900 block font-bold">Q：我已经用经典版 Wix 做了网站，可以直接一键升级到 Studio 吗？</strong>
        <p class="text-slate-600 text-xs leading-relaxed">
          官方支持将普通 Wix 网站升级进入 Studio 模式，但由于底层排版引擎完全不同，升级后建议重新检查每个断点的容器嵌套与停靠关系。商业数据（订单、会员、CMS）完全不受影响，平滑保留。
        </p>
