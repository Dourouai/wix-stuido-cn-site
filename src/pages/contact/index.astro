---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroMarketing from '../../components/HeroMarketing.astro';
import Icon from '../../components/Icon.astro';
---

<BaseLayout
  title="联系我们与建站咨询 | Wix Studio 官方认证定制服务 - wixstudio.cn"
  description="告诉我们您的网站建设或出海官网需求。Wix 官方最高级 Legend 认证合作伙伴，提供专业 Wix Studio 外贸独立站、品牌官网定制与技术开发咨询。"
  keywords="Wix 代建站, Wix 建站服务, Wix Studio 定制, Wix 外贸建站, Wix 专家咨询"
>
  <!-- Marketing Hero Header -->
  <HeroMarketing
    label="START A PROJECT · 开启合作"
    title="开启您的 Wix Studio 建站项目"
    subtitle="无论您有外贸独立站定制、出海品牌重塑，还是复杂动态功能开发需求，请提交表单或即时与我们联络。"
  />

  <main class="bg-gray-50/50 py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">

        <!-- Left Column: HubSpot Embed Form Container (7 Cols) -->
        <div class="lg:col-span-7 bg-white rounded-3xl p-6 sm:p-10 border border-gray-200/90 shadow-sm space-y-6">
          <div class="border-b border-gray-150 pb-5">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-[#116DFF] text-xs font-bold mb-2">
              <span class="w-2 h-2 rounded-full bg-[#116DFF]"></span>
              在线咨询意向登记
            </div>
            <h2 class="text-xl sm:text-2xl font-black text-gray-900">告诉我们您的项目需求</h2>
            <p class="text-xs sm:text-sm text-gray-500 mt-1">
              请尽量详尽填写您的核心诉求，官方 Legend 顾问将在 24 小时内与您深度对接。
            </p>
          </div>

          <!-- HubSpot Embed Form Target Container -->
          <div id="hubspot-form-target" class="min-h-[380px] flex items-center justify-center">
            <!-- Loading indicator before HS script initializes -->
            <div class="text-center text-xs text-gray-400 py-12 space-y-3">
              <div class="w-8 h-8 border-2 border-[#116DFF] border-t-transparent rounded-full animate-spin mx-auto"></div>
              <div>正在加载官方安全咨询表单...</div>
            </div>
          </div>
        </div>

        <!-- Right Column: Contact Cards, Legend Badge & Info (5 Cols) -->
        <div class="lg:col-span-5 space-y-6">

          <!-- Direct WeChat & Email Contact Card -->
          <div class="bg-white rounded-3xl p-6 sm:p-7 border border-gray-200/90 shadow-xs space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-gray-400">即时沟通 / Direct Contact</span>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-600 text-[11px] font-semibold border border-emerald-100">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                工作日即时响应
              </span>
            </div>

            <div class="space-y-3 pt-1">
              <!-- WeChat -->
              <div class="p-4 rounded-2xl bg-gray-50/80 border border-gray-150 flex items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-emerald-500 text-white flex items-center justify-center shrink-0 shadow-xs">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M8.691 2.188C3.891 2.188 0 5.478 0 9.53c0 2.212 1.17 4.203 3.002 5.55a.59.59 0 0 1 .213.665l-.39 1.48c-.019.07-.048.141-.048.213 0 .161.13.292.292.292a.3.3 0 0 0 .151-.041l1.91-1.103a.74.74 0 0 1 .593-.08c1.02.26 2.09.4 3.19.4.19 0 .37-.01.55-.02-.13-.53-.2-1.09-.2-1.66 0-4.43 4.14-8.03 9.25-8.03.22 0 .44.01.66.03C17.65 5.258 13.51 2.188 8.69 2.188zm-2.3 4.094c.66 0 1.2.54 1.2 1.2s-.54 1.2-1.2 1.2-1.2-.54-1.2-1.2.54-1.2 1.2-1.2zm5.72 0c.66 0 1.2.54 1.2 1.2s-.54 1.2-1.2 1.2-1.2-.54-1.2-1.2.54-1.2 1.2-1.2z"/>
                      <path d="M16.25 10.375c-4.14 0-7.5 2.92-7.5 6.523 0 1.954 1.01 3.712 2.61 4.9.15.11.23.29.19.47l-.27 1.04a.26.26 0 0 0 .35.31l1.37-.79c.17-.1.38-.13.57-.08.85.22 1.77.34 2.73.34 4.14 0 7.5-2.92 7.5-6.523s-3.36-6.523-7.5-6.523zm-2.05 3.61c.49 0 .89.4.89.89s-.4.89-.89.89-.89-.4-.89-.89.4-.89.89-.89zm4.28 0c.49 0 .89.4.89.89s-.4.89-.89.89-.89-.4-.89-.89.4-.89.89-.89z"/>
                    </svg>
                  </div>
                  <div>
                    <div class="text-xs text-gray-500 font-medium">微信咨询 (WeChat)</div>
                    <div class="text-sm font-bold text-gray-900 font-mono mt-0.5 select-all">CloudCollect</div>
                  </div>
                </div>
                <button
                  class="copy-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-[#116DFF] hover:bg-blue-50 transition border border-blue-100"
                  data-copy="CloudCollect"
                >
                  复制微信号
                </button>
              </div>

              <!-- Email -->
              <div class="p-4 rounded-2xl bg-gray-50/80 border border-gray-150 flex items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-[#116DFF] text-white flex items-center justify-center shrink-0 shadow-xs">
                    <Icon name="mail" class="w-5 h-5" />
                  </div>
                  <div>
                    <div class="text-xs text-gray-500 font-medium">官方商务邮箱 (Email)</div>
                    <a href="mailto:info@lopuo.com" class="text-sm font-bold text-gray-900 font-mono mt-0.5 hover:text-[#116DFF] transition block select-all">
                      info@lopuo.com
                    </a>
                  </div>
                </div>
                <button
                  class="copy-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-[#116DFF] hover:bg-blue-50 transition border border-blue-100"
                  data-copy="info@lopuo.com"
                >
                  复制邮箱
                </button>
              </div>
            </div>
          </div>

          <!-- Legend Partner Badge Card -->
          <div class="rounded-3xl p-7 border border-blue-100 bg-gradient-to-br from-blue-50/70 via-white to-white space-y-4 shadow-xs">
            <div class="flex items-center gap-4">
              <img
                src="/assets/badges/wix-partner-legend-200.png"
                alt="Wix Partner Legend"
                width="64"
                height="64"
                class="rounded-full shadow-md shadow-gray-300/60"
              />
              <div>
                <div class="text-xs font-bold uppercase tracking-wider text-[#116DFF]">WIX PARTNER LEGEND</div>
                <h3 class="text-base font-black text-gray-900">官方最高等级认证伙伴</h3>
                <div class="text-xs text-gray-500 mt-0.5">实战交付数十款企业级出海独立站</div>
              </div>
            </div>
            <p class="text-xs text-gray-600 leading-relaxed pt-3 border-t border-gray-150">
              依托 Wix Studio 流体引擎与 Velo 全栈能力，为企业量身定制兼具硅谷级美学设计、闪电加载速度与出色 Google 搜索引擎排名的出海门户。
            </p>
          </div>

          <!-- Service Process Highlight -->
          <div class="bg-white rounded-3xl p-6 sm:p-7 border border-gray-200/90 shadow-xs space-y-4">
            <div class="text-xs font-bold uppercase tracking-wider text-gray-400">标准交付工作流</div>
            <ol class="space-y-3 text-xs text-gray-600">
              <li class="flex items-start gap-2.5">
                <span class="w-5 h-5 rounded-full bg-blue-50 text-[#116DFF] flex items-center justify-center font-bold shrink-0 mt-0.5">1</span>
                <div><strong>需求梳理与标杆对齐：</strong>明确项目定位、目标受众与期望参考站点。</div>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="w-5 h-5 rounded-full bg-blue-50 text-[#116DFF] flex items-center justify-center font-bold shrink-0 mt-0.5">2</span>
                <div><strong>原型与流体排版设计：</strong>首页视觉主张、断点网格与交互逻辑确认。</div>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="w-5 h-5 rounded-full bg-blue-50 text-[#116DFF] flex items-center justify-center font-bold shrink-0 mt-0.5">3</span>
                <div><strong>全响应式开发与动效：</strong>Velo 动态数据绑定与微交互落地。</div>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="w-5 h-5 rounded-full bg-blue-50 text-[#116DFF] flex items-center justify-center font-bold shrink-0 mt-0.5">4</span>
                <div><strong>域名上线与后台交付培训：</strong>Google/百度收录配置、上线验收与使用培训。</div>
              </li>
            </ol>
          </div>

        </div>

      </div>
    </div>
  </main>

  <!-- HubSpot Embed Form Script -->
  <script is:inline charset="utf-8" type="text/javascript" src="//js-na2.hsforms.net/forms/embed/v2.js"></script>
  <script is:inline>
    // Initialize HubSpot form
    if (window.hbspt) {
      window.hbspt.forms.create({
        portalId: "22304341",
        formId: "9201ea63-a8ff-45f0-afea-3979c65950c1",
        region: "na2",
        target: "#hubspot-form-target"
      });
    } else {
      // Fallback polling in case script is async
      var checkHS = setInterval(function() {
        if (window.hbspt) {
          clearInterval(checkHS);
          window.hbspt.forms.create({
            portalId: "22304341",
            formId: "9201ea63-a8ff-45f0-afea-3979c65950c1",
            region: "na2",
            target: "#hubspot-form-target"
          });
        }
      }, 100);
    }

    // Quick Copy interaction
    document.querySelectorAll('.copy-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var text = btn.getAttribute('data-copy');
        if (text && navigator.clipboard) {
          navigator.clipboard.writeText(text).then(function() {
            var oldText = btn.innerText;
            btn.innerText = '已复制！';
            setTimeout(function() {
              btn.innerText = oldText;
            }, 1500);
          });
        }
      });
    });
  </script>
</BaseLayout>
