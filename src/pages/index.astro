---
import BaseLayout from '../layouts/BaseLayout.astro';

const tutorials = [
  {
    icon: '📘',
    title: '入门基础',
    tag: 'Beginner',
    desc: '从账号注册、工作空间认知到发布首个响应式站点，零基础手把手教程。',
    href: '/tutorials/getting-started/',
  },
  {
    icon: '🎨',
    title: '响应式设计',
    tag: 'Design',
    desc: '掌握断点设置、流体排版（Fluid Engine）与高级微交互动画，告别多端错乱。',
    href: '/tutorials/design/',
  },
  {
    icon: '💻',
    title: 'Velo开发',
    tag: 'Code',
    desc: '利用 JavaScript、Wix CMS 数据库及 API 接口，轻松实现企业级动态数据交互。',
    href: '/tutorials/velo/',
  },
  {
    icon: '🔍',
    title: 'SEO优化',
    tag: 'SEO',
    desc: '百度与 Google 双引擎技术 SEO 调优、Sitemap 自动提交及 Core Web Vitals 达标。',
    href: '/tutorials/seo/',
  },
  {
    icon: '🛒',
    title: '电商建站',
    tag: 'E-Com',
    desc: '跨境多币种独立站、PayPal / Stripe 海外金流收款及库存物流系统全流程配置。',
    href: '/tutorials/ecommerce/',
  },
  {
    icon: '⚡',
    title: '竞品对比',
    tag: 'Compare',
    desc: '深度横评 Wix 与 Shopify、WordPress、Webflow、Squarespace，明晰各家优劣。',
    href: '/compare/',
  },
];

const compareItems = [
  {
    name: 'Wix vs Shopify',
    badge: '跨境出海',
    highlight: '外贸商城与独立站首选对比',
    wixAdv: '设计自由度极高，无需月度昂贵插件堆砌，展示型电商与 B2B 品牌官网首选',
    otherAdv: '超大 SKU 铺货型 B2C 具备深厚 ERP 生态',
    href: '/compare/wix-vs-shopify/',
  },
  {
    name: 'Wix vs WordPress',
    badge: '现代选型',
    highlight: '闭源现代SaaS vs 开源CMS终极选型',
    wixAdv: '零运维成本、无需担心安全漏洞升级、原生云端全托管高防，省心省力',
    otherAdv: '开源生态与二次开发自主权最高',
    href: '/compare/wix-vs-wordpress/',
  },
  {
    name: 'Wix Studio vs Webflow',
    badge: '设计进阶',
    highlight: '专业设计师建站平台深度较量',
    wixAdv: '原生内置全套商务应用（预约/商城/会员/表单）、中文生态友好、交付周期更短',
    otherAdv: '底层 CSS 盒模型代码控制极深',
    href: '/compare/wix-vs-webflow/',
  },
];

const stats = [
  { value: '35+', label: '篇系统中文教程' },
  { value: '5年+', label: 'Wix 实战出海经验' },
  { value: '100%', label: '原生流体响应式' },
  { value: 'Legend', label: 'Wix 官方最高认证' },
];

const faqs = [
  {
    q: 'Wix Studio 是什么？和普通的经典版 Wix 有什么区别？',
    a: 'Wix Studio 是 Wix 专为设计师、建站代理商和技术开发者打造的下一代旗舰平台。它支持像素级流体断点（Fluid Responsive）、自定义 CSS、团队共享设计系统（Design System）及更强大的 Velo 代码扩展，突破了经典版 Wix 的自由度局限。',
  },
  {
    q: '使用 Wix 建站需要懂得写代码吗？',
    a: '完全不需要。Wix Studio 提供所见即所得的可视化流体编辑器与内置智能 AI 辅助，小白和设计师均可轻松拖拽排版发布上线；如果遇到复杂业务数据逻辑，开发者也可以随时开启 Velo 编写全栈 JavaScript。',
  },
  {
    q: 'Wix 网站在中国大陆访问速度如何？能做外贸独立站吗？',
    a: 'Wix 采用全球 300+ 节点的多区域 CDN 架构，针对海外买家访问极其高速流畅，是外贸 B2B 官网和跨境品牌出海的理想之选；对于国内大陆访客，我们提供了完整的 DNS 优化与静态资源加速调优方案。',
  },
  {
    q: 'wixstudio.cn 能够帮我们定制企业官网或商城吗？',
    a: '可以！我们是获得 Wix 官方认证的最高级别 Legend 级合作伙伴（Wix Partner Legend），拥有丰富的出海官网、设计作品集及动态交互网站定制经验，提供从品牌策划、视觉设计到交付上线的一站式服务。',
  },
  {
    q: 'Wix 建站如何绑定自己的独立顶级域名？',
    a: '只需购买任意 Wix 商业套餐，即可在后台直接将您的 .com、.cn 或其他国际域名 DNS 解析至 Wix 服务器，系统会自动签发免费的全球高可用 SSL 安全证书。',
  },
];
---

<BaseLayout>
  <!-- Hero Section with Light Grid and Soft Pastel Glow -->
  <section class="relative overflow-hidden pt-16 pb-24 md:pt-24 md:pb-32 bg-dots-light">
    <!-- Soft Dreamy Glow -->
    <div class="hero-glow-light"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        <!-- Left Hero Content -->
        <div class="lg:col-span-7 space-y-7 text-left">
          <!-- Trust Badge Pill -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-purple-200/80 shadow-xs shadow-purple-500/5 hover:border-purple-300 transition">
            <span class="flex h-2 w-2 relative">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-[#7C3AED]"></span>
            </span>
            <span class="text-xs font-semibold text-gray-800 tracking-wide">
              Wix 官方认证 <span class="text-[#6D28D9] font-bold">Legend</span> 合作伙伴
            </span>
          </div>

          <!-- Headline -->
          <div class="space-y-2">
            <div class="text-[#0F172A] text-5xl sm:text-7xl lg:text-8xl font-black tracking-tighter leading-none">
              Wix Studio
            </div>
            <div class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight leading-tight text-gradient-brand">
              中文学习与建站平台
            </div>
          </div>

          <!-- Subtitle -->
          <p class="text-base sm:text-xl text-gray-600 max-w-xl font-normal leading-relaxed">
            中文互联网最系统的 Wix Studio 专属生态。从零基础建站到设计师进阶，提供实战教程、平台横评与高水准外贸出海官网定制。
          </p>

          <!-- Dual CTAs -->
          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href="/tutorials/"
              class="btn-primary-glow inline-flex items-center gap-2 px-7 py-3.5 rounded-full text-base font-semibold text-white bg-gradient-to-r from-[#6D28D9] to-[#2563EB] shadow-lg shadow-purple-500/20 active:scale-95 transition"
            >
              <span>Browse Tutorials</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
            <a
              href="/contact/"
              class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full text-base font-semibold text-gray-800 bg-white hover:bg-gray-50 border border-gray-300/80 shadow-xs hover:border-purple-300 active:scale-95 transition"
            >
              <span>Get a Website</span>
              <span class="text-gray-400">→</span>
            </a>
          </div>

          <!-- Social Proof / Stats Grid -->
          <div class="pt-6 border-t border-gray-200/80 grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6">
            {stats.map((s) => (
              <div>
                <div class="text-2xl sm:text-3xl font-black text-[#0F172A] tracking-tight">{s.value}</div>
                <div class="text-xs text-gray-500 mt-0.5">{s.label}</div>
              </div>
            ))}
          </div>
        </div>

        <!-- Right Hero Mockup: Modern Crisp Editor Frame -->
        <div class="lg:col-span-5 relative">
          <div class="relative light-card border border-gray-200/90 p-2 sm:p-3 shadow-2xl shadow-purple-950/10 bg-white overflow-hidden">
            <!-- Studio Editor Top Toolbar -->
            <div class="flex items-center justify-between px-3 py-2 border-b border-gray-100 bg-gray-50 rounded-t-xl text-xs">
              <!-- Window Dots -->
              <div class="flex items-center gap-1.5">
                <div class="w-2.5 h-2.5 rounded-full bg-red-400"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-amber-400"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-emerald-400"></div>
              </div>

              <!-- Breakpoint Switcher (Desktop / Tablet / Mobile) -->
              <div class="flex items-center gap-1 bg-white p-0.5 rounded-lg border border-gray-200 shadow-xs">
                <button class="px-2 py-0.5 rounded bg-[#6D28D9] text-white text-[11px] font-semibold flex items-center gap-1">
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                  <span>1920</span>
                </button>
                <button class="px-2 py-0.5 rounded text-gray-400 hover:text-gray-700 text-[11px] flex items-center">
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                </button>
                <button class="px-2 py-0.5 rounded text-gray-400 hover:text-gray-700 text-[11px] flex items-center">
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                </button>
              </div>

              <!-- Publish Status -->
              <div class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                <span class="text-[11px] font-semibold text-emerald-600">Published</span>
              </div>
            </div>

            <!-- Editor Inner Canvas with Side Rail -->
            <div class="flex bg-gray-50/70 rounded-b-xl overflow-hidden min-h-[300px]">
              <!-- Left Tool Rail -->
              <div class="w-10 border-r border-gray-200/80 bg-white py-3 flex flex-col items-center gap-3 text-gray-400 text-xs">
                <span class="w-6 h-6 rounded-md flex items-center justify-center bg-purple-50 text-[#6D28D9] font-bold cursor-pointer">+</span>
                <span class="hover:text-gray-700 cursor-pointer">📄</span>
                <span class="hover:text-gray-700 cursor-pointer">🎨</span>
                <span class="hover:text-gray-700 cursor-pointer">📦</span>
                <span class="hover:text-[#6D28D9] cursor-pointer font-mono font-bold text-[10px] text-purple-600">{ }</span>
              </div>

              <!-- Canvas Preview Area -->
              <div class="flex-1 p-5 relative flex flex-col justify-between bg-gradient-to-br from-white to-purple-50/30">
                <!-- Selection Box Handles Simulated -->
                <div class="border-2 border-[#6D28D9] rounded-xl p-5 relative bg-white shadow-lg shadow-purple-500/5">
                  <!-- Handle points -->
                  <div class="w-2.5 h-2.5 rounded-full bg-[#6D28D9] absolute -top-1.5 -left-1.5 border-2 border-white"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#6D28D9] absolute -top-1.5 -right-1.5 border-2 border-white"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#6D28D9] absolute -bottom-1.5 -left-1.5 border-2 border-white"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#6D28D9] absolute -bottom-1.5 -right-1.5 border-2 border-white"></div>

                  <div class="flex items-center justify-between mb-3">
                    <span class="text-[10px] uppercase font-mono px-2 py-0.5 rounded bg-purple-100 text-[#6D28D9] font-bold">
                      Fluid: Scale Proportionally
                    </span>
                    <span class="text-[10px] text-gray-400 font-mono">W: 100% | Auto</span>
                  </div>

                  <div class="space-y-2.5">
                    <div class="h-3 w-1/3 rounded bg-purple-200"></div>
                    <div class="h-6 w-5/6 rounded bg-gradient-to-r from-gray-900 to-gray-600"></div>
                    <div class="h-2.5 w-1/2 rounded bg-gray-300"></div>
                  </div>

                  <div class="mt-4 flex items-center gap-2">
                    <span class="px-3 py-1 rounded-full text-[11px] font-semibold bg-[#6D28D9] text-white">Explore</span>
                    <span class="px-3 py-1 rounded-full text-[11px] font-medium border border-gray-300 text-gray-700 bg-white">Demo</span>
                  </div>
                </div>

                <!-- Bottom Status info -->
                <div class="mt-4 flex items-center justify-between text-[10px] text-gray-400 font-mono">
                  <span>CSS Grid: 12 Cols</span>
                  <span>Velo: Ready</span>
                </div>
              </div>
            </div>

            <!-- Floating Wix Partner Legend Badge with Drop Shadow -->
            <div class="absolute -bottom-3 -right-3 w-20 h-20 sm:w-24 sm:h-24 z-20 transition-transform hover:scale-105">
              <div class="relative w-full h-full">
                <img
                  src="/assets/badges/wix-partner-legend-200.png"
                  alt="Wix Partner Legend"
                  width="96"
                  height="96"
                  class="rounded-full border-2 border-white shadow-xl shadow-gray-900/20"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Platform Marquee Ticker in Crisp Light Banner -->
  <section class="border-y border-gray-200/80 bg-white py-5 overflow-hidden">
    <div class="marquee-mask-light">
      <div class="animate-marquee items-center gap-12 text-sm sm:text-base font-semibold tracking-wider text-gray-400 whitespace-nowrap">
        <span class="text-[#0F172A] font-bold">WIX STUDIO</span>
        <span>•</span>
        <span>VELO JAVASCRIPT</span>
        <span>•</span>
        <span>SHOPIFY</span>
        <span>•</span>
        <span>WORDPRESS</span>
        <span>•</span>
        <span>WEBFLOW</span>
        <span>•</span>
        <span>SQUARESPACE</span>
        <span>•</span>
        <span>FRAMER</span>
        <span>•</span>
        <span class="text-[#0F172A] font-bold">WIX STUDIO</span>
        <span>•</span>
        <span>VELO JAVASCRIPT</span>
        <span>•</span>
        <span>SHOPIFY</span>
        <span>•</span>
        <span>WORDPRESS</span>
        <span>•</span>
        <span>WEBFLOW</span>
        <span>•</span>
        <span>SQUARESPACE</span>
        <span>•</span>
        <span>FRAMER</span>
      </div>
    </div>
  </section>

  <!-- Section 3: Tutorials Cards Grid in Clean White Cards -->
  <section class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
      <div class="inline-block text-xs font-bold uppercase tracking-widest text-[#6D28D9] px-3 py-1 rounded-full bg-purple-50 border border-purple-200">
        TUTORIALS 教程体系
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-[#0F172A] tracking-tight">
        从零开始学 Wix Studio
      </h2>
      <p class="text-base text-gray-600">
        循序渐进的系统化中文课程，覆盖从基础搭建、高阶设计到代码扩展全流程。
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {tutorials.map((card) => (
        <a
          href={card.href}
          class="light-card p-7 group flex flex-col justify-between block relative overflow-hidden"
        >
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <div class="w-12 h-12 rounded-2xl bg-purple-50 border border-purple-100 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
                {card.icon}
              </div>
              <span class="text-[11px] font-semibold uppercase tracking-wider text-purple-700 bg-purple-50 border border-purple-100 px-2.5 py-1 rounded-full">
                {card.tag}
              </span>
            </div>
            <h3 class="text-xl font-bold text-[#0F172A] group-hover:text-[#6D28D9] transition">
              {card.title}
            </h3>
            <p class="text-sm text-gray-500 leading-relaxed">
              {card.desc}
            </p>
          </div>

          <div class="pt-6 mt-4 border-t border-gray-100 flex items-center justify-between text-xs font-semibold text-gray-700 group-hover:text-[#6D28D9] transition">
            <span>Learn More</span>
            <span class="transform group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-12 text-center">
      <a
        href="/tutorials/"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-sm font-semibold text-gray-700 hover:text-gray-900 bg-white border border-gray-300 hover:border-purple-300 shadow-xs transition"
      >
        <span>查看所有 35+ 篇教程大纲</span>
        <span>→</span>
      </a>
    </div>
  </section>

  <!-- Section 4: Platform Compare Highlights in Clean Slate Style -->
  <section class="py-24 bg-[#F8FAFC] border-y border-gray-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-4 space-y-4">
          <div class="inline-block text-xs font-bold uppercase tracking-widest text-[#6D28D9] px-3 py-1 rounded-full bg-purple-100/60 border border-purple-200">
            COMPARISONS 选型横评
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-[#0F172A] tracking-tight leading-snug">
            选对建站平台<br />事半功倍
          </h2>
          <p class="text-sm text-gray-600 leading-relaxed">
            不知道是用 Wix、Shopify 还是 WordPress？我们以中国企业和出海卖家的真实业务场景为准绳，为您做客观剖析。
          </p>
          <div class="pt-2">
            <a
              href="/compare/"
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#6D28D9] hover:underline"
            >
              <span>查看 5 大主流平台综合横评报告</span>
              <span>→</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-8 space-y-4">
          {compareItems.map((item) => (
            <a
              href={item.href}
              class="light-card p-6 block group hover:border-purple-300 transition"
            >
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-gray-100">
                <div class="flex items-center gap-2">
                  <h3 class="text-lg font-bold text-[#0F172A] group-hover:text-[#6D28D9] transition">
                    {item.name}
                  </h3>
                  <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-gray-100 text-gray-600 border border-gray-200">
                    {item.badge}
                  </span>
                </div>
                <span class="text-xs text-[#6D28D9] font-medium flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                  查看深度对比 →
                </span>
              </div>
              <div class="mt-3.5 grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs leading-relaxed">
                <div class="p-3 rounded-xl bg-emerald-50/70 border border-emerald-200 text-gray-700">
                  <span class="text-emerald-700 font-semibold block mb-0.5">Wix 优势：</span>
                  {item.wixAdv}
                </div>
                <div class="p-3 rounded-xl bg-gray-50 border border-gray-200 text-gray-600">
                  <span class="text-gray-800 font-semibold block mb-0.5">竞品侧重点：</span>
                  {item.otherAdv}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Section 5: Wix Partner Legend Certification Authority (Bright Premium Banner) -->
  <section class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="rounded-3xl p-8 sm:p-14 border border-purple-200/80 bg-gradient-to-br from-purple-50/70 via-white to-blue-50/60 relative overflow-hidden shadow-xl shadow-purple-500/5">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
        <div class="lg:col-span-8 space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-100 text-[#6D28D9] text-xs font-semibold border border-purple-200">
            OFFICIAL CERTIFICATION
          </div>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-[#0F172A] leading-tight">
            Wix 官方最高级 Legend 认证合作伙伴
          </h2>
          <p class="text-sm sm:text-base text-gray-600 leading-relaxed max-w-2xl">
