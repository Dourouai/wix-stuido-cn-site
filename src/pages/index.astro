---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

// 精选主打教程
const featured = {
  tag: '新手入门必读',
  title: 'Wix Studio 完整入门指南：从 0 到 1 上线首个流体响应式站点',
  desc: '深度拆解 Studio 编辑器核心面板、比例缩放机制（Scale Proportionally）、断点级排版与独立域名绑定全流程。',
  href: '/tutorials/getting-started/what-is-wix-studio/',
  time: '45 分钟 · 8 篇系统系列',
  badge: '旗舰教程',
  image: '/assets/images/tutorial-featured-cover.jpg',
};

// 教程专栏
const tutorials = [
  { tag: 'Velo 开发', icon: 'code', title: '用 Velo 连接 CMS 数据库，构建企业级动态内容页面', href: '/tutorials/velo/', time: '60 min', color: 'text-emerald-600 bg-emerald-50' },
  { tag: 'SEO 优化', icon: 'search', title: 'Wix Studio 百度 + Google 双引擎 SEO 深度优化指南', href: '/tutorials/seo/', time: '40 min', color: 'text-amber-600 bg-amber-50' },
  { tag: '设计排版', icon: 'palette', title: 'Fluid Engine 流体响应式布局深度解析与微动效落地', href: '/tutorials/design/', time: '55 min', color: 'text-violet-600 bg-violet-50' },
  { tag: '外贸电商', icon: 'shopping-bag', title: '外贸独立站从零搭建：Wix Stores 多币种与支付网关配置', href: '/tutorials/ecommerce/', time: '70 min', color: 'text-orange-600 bg-orange-50' },
  { tag: '平台横评', icon: 'scale', title: 'Wix Studio vs Webflow：设计师视角的深度对比（2026）', href: '/compare/wix-vs-webflow-2026/', time: '30 min', color: 'text-blue-600 bg-blue-50' },
];

// 横评快捷入口
const comparisonCards = [
  {
    target: 'Shopify',
    tag: '独立站选型',
    title: 'Wix vs Shopify 2026 横评',
    desc: '品牌官网+轻量电商选 Wix（0%平台抽成）；海量大宗 SKU 铺货选 Shopify。',
    href: '/compare/wix-vs-shopify-2026/',
    score: '9.4',
    badge: '外贸必读',
    accent: 'from-emerald-500/10 to-transparent border-emerald-200/60',
  },
  {
    target: 'WordPress',
    tag: '运维与安全',
    title: 'Wix vs WordPress 2026 横评',
    desc: '省心免运维高防全托管选 Wix；配备全职运维团队、追求代码私有化选 WP。',
    href: '/compare/wix-vs-wordpress-2026/',
    score: '9.2',
    badge: '成本对比',
    accent: 'from-blue-500/10 to-transparent border-blue-200/60',
  },
  {
    target: 'Webflow',
    tag: '视觉排版高峰',
    title: 'Wix Studio vs Webflow 2026',
    desc: '内置全套商业应用+流体排版选 Wix；追求严苛 CSS 类名手写控制选 Webflow。',
    href: '/compare/wix-vs-webflow-2026/',
    score: '9.5',
    badge: '设计师必读',
    accent: 'from-indigo-500/10 to-transparent border-indigo-200/60',
  },
];

// 博客动态
const posts = [
  {
    category: '设计前沿',
    title: '2026 全球网页设计与数字视觉趋势报告：从多巴胺色彩到流体反设计',
    date: '2026-09-20',
    readTime: '9 分钟',
    href: '/blog/web-design-trends-2026/',
    image: '/assets/images/blog-design-trends.jpg',
  },
  {
    category: '海外营销',
    title: '2026 海外数字营销新法则：第一人称叙事、微网红生态与反向破圈',
    date: '2026-09-20',
    readTime: '8 分钟',
    href: '/blog/marketing-trends-2026/',
    image: '/assets/images/blog-b2b-export.jpg',
  },
  {
    category: '技术进阶',
    title: 'Wix Studio 官方 AI 生产力全面升级：从提示词排版到代码辅助生成的深度剖析',
    date: '2026-09-20',
    readTime: '7 分钟',
    href: '/blog/wix-studio-ai-features/',
    image: '/assets/images/blog-ai-figma.jpg',
  },
];

// 平台特色保障与学习价值点
const trustPoints = [
  { icon: 'book-open', title: '系统化免费教程', desc: '从新手入门到 Velo 全栈开发，35+ 篇实战图文全流程公开' },
  { icon: 'sparkles', title: '生态前沿持续追踪', desc: '每周同步 Wix 官方最新更新、AI 工具演进与外贸建站风向' },
  { icon: 'shield', title: 'Legend 导师实力背书', desc: '官方最高级认证伙伴执笔，拒绝纸上谈兵，纯一线实操复盘' },
  { icon: 'scale', title: '2026 客观平台横评', desc: '横向深度比对 Shopify、WordPress、Webflow，理性辅助选型' },
];
---

<BaseLayout
  title="wixstudio.cn — 中文最系统的 Wix Studio 教程与建站资讯平台"
  description="中国权威 Wix Studio 中文学习与建站推广中心。由官方 Legend 级认证伙伴倾力打造，系统涵盖入门教程、流体设计排版、Velo全栈开发与主流平台横评。"
>

  <!-- ══════════════════════════════════════════
       SECTION 1: HERO (Wix Studio 交互式设计工作台旗舰展示)
       ══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-gradient-to-b from-[#F0F5FF] via-[#F8FAFC] to-white border-b border-gray-200/70">

    <!-- 背景质感光效与微圆点纹理 -->
    <div class="absolute inset-0 opacity-40 pointer-events-none"
         style="background-image: radial-gradient(circle, #BFDBFE 1.2px, transparent 1.2px); background-size: 32px 32px;"></div>
    <div class="absolute -top-40 right-10 w-[640px] h-[640px] rounded-full pointer-events-none"
         style="background: radial-gradient(circle, rgba(17,109,255,0.12) 0%, rgba(99,102,241,0.06) 40%, transparent 70%);"></div>
    <div class="absolute top-1/3 -left-40 w-[500px] h-[500px] rounded-full pointer-events-none"
         style="background: radial-gradient(circle, rgba(147,197,253,0.2) 0%, transparent 70%);"></div>

    <!-- 顶部极简装饰标尺元素 -->
    <div class="hidden lg:flex absolute top-4 left-1/2 -translate-x-1/2 items-center gap-6 text-[10px] font-mono text-gray-300 pointer-events-none select-none">
      <span>+ [0, 0]</span>
      <span class="w-32 h-px bg-gray-200"></span>
      <span>CANVAS: FLUID RESPONSIVE</span>
      <span class="w-32 h-px bg-gray-200"></span>
      <span>+ [1920, 1080]</span>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-16 sm:pt-16 sm:pb-20 lg:pt-20 lg:pb-24 relative">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">

        <!-- 左侧：文案与核心呼吁 (6 Cols) -->
        <div class="lg:col-span-6 space-y-6">
          <!-- 官方认证品质徽章 -->
          <div class="hero-enter hero-enter-d1 inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full border border-blue-200/90 bg-white/95 shadow-xs text-xs font-semibold text-gray-700 backdrop-blur-md">
            <span class="flex h-2 w-2 relative">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#116DFF] opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-[#116DFF]"></span>
            </span>
            <span class="text-gray-500">Wix 官方最高级认证</span>
            <span class="h-3 w-px bg-gray-200"></span>
            <span class="text-[#116DFF] font-bold flex items-center gap-1">
              <svg class="w-3.5 h-3.5 text-amber-500 fill-amber-400" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              Legend 导师团队主编
            </span>
          </div>

          <!-- 主标题：强化 Wix Studio 与权威教程资讯定位 -->
          <div class="hero-enter hero-enter-d2 space-y-2">
            <div class="text-xs font-bold tracking-widest text-[#116DFF] uppercase flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[#116DFF]"></span>
              WIX STUDIO KNOWLEDGE HUB · 2026
            </div>
            <h1 class="text-3xl sm:text-4xl lg:text-[50px] font-black leading-[1.14] tracking-tight text-gray-900"
                style="font-family: 'Inter', 'Noto Sans SC', 'PingFang SC', system-ui, sans-serif;">
              中文最系统的<br />
              <span class="bg-gradient-to-r from-[#116DFF] via-[#0D5FE3] to-[#4F46E5] bg-clip-text" style="-webkit-text-fill-color: transparent;">Wix Studio</span>
              教程与前沿资讯中心
            </h1>
          </div>

          <!-- 副标题：突出受众、路径与避坑价值 -->
          <p class="hero-enter hero-enter-d3 text-sm sm:text-base text-gray-600 leading-relaxed max-w-xl">
            面向网页设计师、出海从业者与独立创作者。涵盖从零基础入门、流体排版进阶到 Velo 全栈开发，每天同步生态前沿动态与深度横评。
          </p>

          <!-- 按钮组与安心保障说明 -->
          <div class="hero-enter hero-enter-d4 space-y-3 pt-1">
            <div class="flex flex-wrap items-center gap-3.5">
              <a href="/tutorials/"
                 class="inline-flex items-center gap-2.5 px-6 sm:px-7 py-3.5 rounded-full text-sm font-bold text-white bg-[#116DFF] hover:bg-[#0D5FE3] shadow-lg shadow-blue-500/25 hover:shadow-xl hover:shadow-blue-500/35 hover:-translate-y-0.5 active:scale-95 transition-all duration-200">
                <Icon name="book-open" class="w-4 h-4" />
                <span>免费开启系统学习（35+篇）</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
              </a>
              <a href="/compare/"
                 class="inline-flex items-center gap-2 px-5 sm:px-6 py-3.5 rounded-full text-sm font-semibold text-gray-700 border border-gray-200/90 bg-white hover:border-gray-300 hover:bg-gray-50 shadow-xs active:scale-95 transition-all duration-200">
                <Icon name="scale" class="w-4 h-4 text-gray-500" />
                <span>2026 平台横评</span>
              </a>
            </div>

            <!-- 微承诺 -->
            <div class="flex items-center gap-4 text-xs text-gray-400 font-medium pt-1">
              <span class="flex items-center gap-1 text-gray-500">
                <svg class="w-3.5 h-3.5 text-emerald-500" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                全开源免费教程
              </span>
              <span class="flex items-center gap-1 text-gray-500">
                <svg class="w-3.5 h-3.5 text-emerald-500" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                官方导师一线实操
              </span>
              <span class="flex items-center gap-1 text-gray-500">
                <svg class="w-3.5 h-3.5 text-emerald-500" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                拒绝纯理论灌输
              </span>
            </div>
          </div>

          <!-- 社区受众与学习指标数据带 -->
          <div class="hero-enter hero-enter-d5 pt-6 border-t border-gray-200/70 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <div class="flex -space-x-1.5 overflow-hidden py-0.5">
                <div class="inline-flex h-8 w-8 rounded-full ring-2 ring-white bg-gradient-to-tr from-blue-500 to-indigo-600 items-center justify-center text-white shadow-xs" title="UI 视觉设计">
                  <Icon name="palette" class="w-4 h-4 text-white" />
                </div>
                <div class="inline-flex h-8 w-8 rounded-full ring-2 ring-white bg-gradient-to-tr from-violet-500 to-purple-600 items-center justify-center text-white shadow-xs" title="Velo 全栈开发">
                  <Icon name="code" class="w-4 h-4 text-white" />
                </div>
                <div class="inline-flex h-8 w-8 rounded-full ring-2 ring-white bg-gradient-to-tr from-emerald-500 to-teal-600 items-center justify-center text-white shadow-xs" title="B2B 出海贸易">
                  <Icon name="globe" class="w-4 h-4 text-white" />
                </div>
                <div class="inline-flex h-8 w-8 rounded-full ring-2 ring-white bg-gradient-to-tr from-amber-500 to-orange-600 items-center justify-center text-white shadow-xs" title="SEO 增长获客">
                  <Icon name="search" class="w-4 h-4 text-white" />
                </div>
              </div>
              <div>
                <div class="text-xs font-bold text-gray-900">3,200+ 名创作者</div>
                <div class="text-[11px] text-gray-400">正在此学习与交流经验</div>
              </div>
            </div>

            <div class="h-8 w-px bg-gray-200 hidden sm:block"></div>

            <div class="flex items-center gap-5 sm:gap-6">
              <div>
                <div class="text-xl sm:text-2xl font-black text-gray-900 tracking-tight">35<span class="text-[#116DFF]">+</span></div>
                <div class="text-[10px] sm:text-[11px] text-gray-400">中文系统专栏</div>
              </div>
              <div>
                <div class="text-xl sm:text-2xl font-black text-gray-900 tracking-tight">每周<span class="text-[#116DFF]">更</span></div>
                <div class="text-[10px] sm:text-[11px] text-gray-400">前沿动态横评</div>
              </div>
              <div>
                <div class="text-xl sm:text-2xl font-black text-gray-900 tracking-tight">100<span class="text-[#116DFF]">%</span></div>
                <div class="text-[10px] sm:text-[11px] text-gray-400">实操避坑原创</div>
              </div>
            </div>
          </div>
        </div>

        <!-- 右侧：Wix Studio 视觉 IDE & 交互式学习工作台 (6 Cols) -->
        <div class="lg:col-span-6 hero-enter hero-enter-d3">
          <div class="relative mx-auto max-w-lg lg:max-w-none">

            <!-- 装饰外光晕 -->
            <div class="absolute -inset-1.5 bg-gradient-to-r from-blue-500/20 via-indigo-500/15 to-purple-500/20 rounded-3xl blur-xl opacity-75"></div>

            <!-- 主工作台卡片 (Mac 窗口风格) -->
            <div class="relative bg-white rounded-3xl border border-gray-200/90 shadow-2xl shadow-blue-900/10 overflow-hidden">

              <!-- 顶部工具栏 (Studio Editor Header) -->
              <div class="bg-gray-50/90 border-b border-gray-200/80 px-4 py-3 flex items-center justify-between">
                <!-- Mac 交通灯 -->
                <div class="flex items-center gap-1.5">
                  <span class="w-3 h-3 rounded-full bg-[#FF5F56] border border-black/10"></span>
                  <span class="w-3 h-3 rounded-full bg-[#FFBD2E] border border-black/10"></span>
                  <span class="w-3 h-3 rounded-full bg-[#27C93F] border border-black/10"></span>
                </div>

                <!-- 响应式视口切换指示器 (Desktop / Tablet / Mobile) -->
                <div class="flex items-center gap-1 bg-white px-2 py-1 rounded-full border border-gray-200 shadow-2xs text-[11px] font-semibold text-gray-600">
                  <span class="px-2 py-0.5 rounded-full bg-blue-50 text-[#116DFF] font-bold flex items-center gap-1">
                    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                    1920 Desktop
                  </span>
                  <span class="px-1.5 py-0.5 text-gray-400 hover:text-gray-700 cursor-default">768</span>
                  <span class="px-1.5 py-0.5 text-gray-400 hover:text-gray-700 cursor-default">390</span>
                </div>

                <!-- 流体缩放状态 -->
                <div class="flex items-center gap-1.5 text-[11px] font-mono text-gray-400">
                  <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                  <span class="hidden sm:inline">Scale 100%</span>
                </div>
              </div>

              <!-- 主画布工作区 (Canvas Live Preview) -->
              <div class="relative bg-[#F8FAFC] p-4 sm:p-6 overflow-hidden min-h-[300px] flex flex-col justify-between">

                <!-- 画布背景网格参考线 -->
                <div class="absolute inset-0 opacity-25 pointer-events-none"
                     style="background-image: linear-gradient(to right, #94a3b8 1px, transparent 1px), linear-gradient(to bottom, #94a3b8 1px, transparent 1px); background-size: 24px 24px;"></div>

                <!-- 正在编辑中的选中容器 (Selected Element with Studio Transform Anchors) -->
                <div class="relative z-10 bg-white/95 rounded-2xl border-2 border-[#116DFF] p-4 sm:p-5 shadow-lg shadow-blue-500/10">

                  <!-- Wix Studio 元素选框标牌 -->
                  <div class="absolute -top-3 left-4 px-2 py-0.5 rounded-md bg-[#116DFF] text-white text-[10px] font-mono font-bold uppercase tracking-wider flex items-center gap-1 shadow-xs">
                    <span>Section: Hero</span>
                    <span class="text-blue-200">· Fluid 100vw</span>
                  </div>

                  <!-- 8 个控制定位锚点 (Handles) -->
                  <span class="absolute -top-1.5 -left-1.5 w-2.5 h-2.5 bg-white border-2 border-[#116DFF] rounded-xs"></span>
                  <span class="absolute -top-1.5 -right-1.5 w-2.5 h-2.5 bg-white border-2 border-[#116DFF] rounded-xs"></span>
                  <span class="absolute -bottom-1.5 -left-1.5 w-2.5 h-2.5 bg-white border-2 border-[#116DFF] rounded-xs"></span>
                  <span class="absolute -bottom-1.5 -right-1.5 w-2.5 h-2.5 bg-white border-2 border-[#116DFF] rounded-xs"></span>

                  <!-- 画布内部模拟排版展示 -->
                  <div class="space-y-3 pt-1">
                    <div class="flex items-center justify-between">
                      <div class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-blue-50 text-[10px] font-bold text-[#116DFF]">
                        <span>Fluid Typography</span>
                        <span class="text-blue-400">clamp(1.5rem, 4vw, 3rem)</span>
                      </div>
                      <span class="text-[10px] font-mono text-gray-400">Flexbox: Row</span>
                    </div>

                    <div class="h-3 w-3/4 rounded-full bg-gray-200/80"></div>
                    <div class="h-2.5 w-1/2 rounded-full bg-gray-100"></div>

                    <!-- 模拟按钮与微动效指示器 -->
                    <div class="flex items-center gap-2 pt-1">
                      <div class="px-3 py-1 rounded-full bg-[#116DFF] text-white text-[10px] font-semibold flex items-center gap-1 shadow-xs">
                        <span>Get Started</span>
                        <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                      </div>
                      <div class="px-2.5 py-1 rounded-full bg-gray-100 text-gray-500 text-[10px] font-medium">
                        Scroll Trigger: Parallax
                      </div>
                    </div>
                  </div>
                </div>

                <!-- 浮动悬浮卡片 1：流体排版属性检查器 (Inspector Floating Card) -->
                <div class="relative z-10 mt-4 sm:mt-5 bg-white/90 backdrop-blur-md rounded-2xl border border-gray-200/80 p-3 shadow-md flex items-center justify-between">
                  <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-xl bg-violet-50 text-violet-600 flex items-center justify-center font-bold text-xs">
                      CSS
                    </div>
                    <div>
                      <div class="text-xs font-bold text-gray-900">Fluid Engine 排版引擎</div>
                      <div class="text-[10px] font-mono text-gray-400">比例缩放无需每屏手动微调</div>
                    </div>
                  </div>
                  <span class="px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-600 border border-emerald-100 text-[10px] font-bold">
                    Core Web Vitals: 99
                  </span>
                </div>

                <!-- 浮动悬浮卡片 2：Velo 代码编辑器抽屉 (Velo Code Mini IDE) -->
                <div class="relative z-10 mt-3 bg-[#0C0C0E] text-white rounded-2xl p-3 shadow-xl font-mono text-[11px] border border-white/10 flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <span class="text-emerald-400 font-bold">$w</span>
                    <span class="text-gray-400">.</span>
                    <span class="text-blue-300">onReady</span>
                    <span class="text-gray-400">(() =&gt;</span>
                    <span class="text-amber-300">initStudioAnimation()</span>
