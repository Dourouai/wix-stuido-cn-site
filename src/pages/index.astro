---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const platforms = [
  { name: 'Wix Studio', icon: 'zap', color: 'bg-purple-50 text-purple-700 border-purple-200' },
  { name: 'Velo JavaScript', icon: 'code', color: 'bg-indigo-50 text-indigo-700 border-indigo-200' },
  { name: 'Shopify', icon: 'shopping-bag', color: 'bg-emerald-50 text-emerald-700 border-emerald-200' },
  { name: 'WordPress', icon: 'globe', color: 'bg-sky-50 text-sky-700 border-sky-200' },
  { name: 'Webflow', icon: 'layout', color: 'bg-blue-50 text-blue-700 border-blue-200' },
  { name: 'Squarespace', icon: 'scale', color: 'bg-slate-50 text-slate-700 border-slate-200' },
  { name: 'Framer', icon: 'sparkles', color: 'bg-pink-50 text-pink-700 border-pink-200' },
];

const tutorials = [
  {
    icon: 'book-open',
    iconBg: 'from-blue-500 to-indigo-600',
    title: '入门基础实战',
    tag: '新手第一课',
    tagColor: 'bg-blue-50 text-blue-700 border-blue-200',
    desc: '从账号注册、Studio 界面工作流认知到发布首个响应式站点，手把手零基础教程。',
    href: '/tutorials/getting-started/',
  },
  {
    icon: 'palette',
    iconBg: 'from-purple-500 to-violet-600',
    title: '流体响应式排版',
    tag: '设计核心',
    tagColor: 'bg-purple-50 text-purple-700 border-purple-200',
    desc: '掌握比例缩放（Fluid Engine）、无限断点适配与滚动微交互动效，告别多端错乱。',
    href: '/tutorials/design/',
  },
  {
    icon: 'code',
    iconBg: 'from-emerald-500 to-teal-600',
    title: 'Velo 全栈开发',
    tag: '动态扩展',
    tagColor: 'bg-emerald-50 text-emerald-700 border-emerald-200',
    desc: '利用 JavaScript、Wix CMS 数据库及 API 接口，轻松实现企业级动态数据交互。',
    href: '/tutorials/velo/',
  },
  {
    icon: 'search',
    iconBg: 'from-amber-500 to-orange-600',
    title: 'SEO 排名优化',
    tag: '流量收录',
    tagColor: 'bg-amber-50 text-amber-700 border-amber-200',
    desc: '百度与 Google 双引擎技术 SEO 调优、Sitemap 自动提交及 Core Web Vitals 达标。',
    href: '/tutorials/seo/',
  },
  {
    icon: 'shopping-bag',
    iconBg: 'from-rose-500 to-pink-600',
    title: '外贸商城独立站',
    tag: '跨境出海',
    tagColor: 'bg-rose-50 text-rose-700 border-rose-200',
    desc: '跨境多币种独立站、PayPal / Stripe 海外金流收款及库存物流系统全流程配置。',
    href: '/tutorials/ecommerce/',
  },
  {
    icon: 'scale',
    iconBg: 'from-cyan-500 to-blue-600',
    title: '主流平台深度横评',
    tag: '技术选型',
    tagColor: 'bg-cyan-50 text-cyan-700 border-cyan-200',
    desc: '客观深度对比 Wix 与 Shopify、WordPress、Webflow、Squarespace，明晰优劣。',
    href: '/compare/',
  },
];

const compareItems = [
  {
    name: 'Wix vs Shopify',
    badge: '跨境出海选型',
    highlight: '外贸商城与独立站首选对比',
    wixAdv: '设计自由度极高，无需月度昂贵插件堆砌，展示型外贸B2B与精品独立站首选',
    otherAdv: '海量 SKU 铺货型 B2C 具备深厚 ERP 发货生态',
    href: '/compare/wix-vs-shopify/',
  },
  {
    name: 'Wix vs WordPress',
    badge: '现代架构对比',
    highlight: '闭源现代SaaS vs 开源CMS终极选型',
    wixAdv: '零运维成本、无需担心安全漏洞攻击挂马、原生云端全托管高防，极度省心',
    otherAdv: '开源生态与二次开发源码自主权最高',
    href: '/compare/wix-vs-wordpress/',
  },
  {
    name: 'Wix Studio vs Webflow',
    badge: '高阶设计工具',
    highlight: '专业设计师建站平台深度较量',
    wixAdv: '原生内置全套商务应用（预约/商城/会员/表单）、中文生态友好、交付周期更短',
    otherAdv: '底层 CSS 盒模型代码控制极深',
    href: '/compare/wix-vs-webflow/',
  },
];

const stats = [
  { value: '35+', label: '篇系统中文教程' },
  { value: '5年+', label: 'Wix 实战出海经验' },
  { value: '100%', label: '原生流体响应式' },
  { value: 'Legend', label: 'Wix 官方最高认证' },
];

const faqs = [
  {
    q: 'Wix Studio 是什么？和普通的经典版 Wix 有什么区别？',
    a: 'Wix Studio 是 Wix 专为设计师、建站代理商和技术开发者打造的下一代旗舰平台。它支持像素级流体断点（Fluid Responsive）、自定义 CSS、团队共享设计系统（Design System）及更强大的 Velo 代码扩展，突破了经典版 Wix 的自由度局限。',
  },
  {
    q: '使用 Wix 建站需要懂得写代码吗？',
    a: '完全不需要。Wix Studio 提供所见即所得的可视化流体编辑器与内置智能 AI 辅助，小白和设计师均可轻松拖拽排版发布上线；如果遇到复杂业务数据逻辑，开发者也可以随时开启 Velo 编写全栈 JavaScript。',
  },
  {
    q: 'Wix 网站在中国大陆访问速度如何？能做外贸独立站吗？',
    a: 'Wix 采用全球 300+ 节点的多区域 CDN 架构，针对海外买家访问极其高速流畅，是外贸 B2B 官网和跨境品牌出海的理想之选；对于国内大陆访客，我们提供了完整的 DNS 优化与静态资源加速调优方案。',
  },
  {
    q: 'wixstudio.cn 能够帮我们定制企业官网或商城吗？',
    a: '可以！我们是获得 Wix 官方认证的最高级别 Legend 级合作伙伴（Wix Partner Legend），拥有丰富的出海官网、设计作品集及动态交互网站定制经验，提供从品牌策划、视觉设计到交付上线的一站式服务。',
  },
  {
    q: 'Wix 建站如何绑定自己的独立顶级域名？',
    a: '只需购买任意 Wix 商业套餐，即可在后台直接将您的 .com、.cn 或其他国际域名 DNS 解析至 Wix 服务器，系统会自动签发免费的全球高可用 SSL 安全证书。',
  },
];
---

<BaseLayout>
  <!-- Section 1: Hero Section (Vibrant Light Aurora + Grid Texture) -->
  <section class="relative overflow-hidden pt-16 pb-24 md:pt-24 md:pb-36 bg-subtle-grid">
    <!-- Rich Aurora Gradient Glow -->
    <div class="hero-aurora"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        <!-- Left Hero Content -->
        <div class="lg:col-span-7 space-y-7 text-left">
          <!-- Official Trust Badge Pill with Shimmer and SVG Star Icon (No Emojis) -->
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/90 border border-purple-200/90 shadow-lg shadow-purple-500/5 shimmer-pill backdrop-blur-md hover:border-purple-300 transition">
            <Icon name="star" class="w-3.5 h-3.5 text-amber-500 fill-amber-500" />
            <span class="text-xs font-bold text-slate-800 tracking-wide">
              Wix 官方认证 <span class="text-[#6D28D9] font-black">Legend</span> 最高级合作伙伴
            </span>
          </div>

          <!-- Hero Headline -->
          <div class="space-y-3">
            <h1 class="text-5xl sm:text-7xl lg:text-8xl font-black tracking-tight text-slate-900 leading-none">
              Wix Studio
            </h1>
            <div class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight text-gradient-purple leading-tight">
              中文学习与建站平台
            </div>
          </div>

          <!-- Subtitle -->
          <p class="text-lg sm:text-xl text-slate-600 max-w-xl font-normal leading-relaxed">
            中文互联网最系统的 Wix Studio 专属生态。从零基础建站到设计师进阶，提供实战教程、平台横评与高水准外贸出海官网定制。
          </p>

          <!-- Dual CTAs -->
          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href="/tutorials/"
              class="btn-vibrant-glow inline-flex items-center gap-2.5 px-8 py-4 rounded-full text-base font-bold text-white bg-gradient-to-r from-[#6D28D9] to-[#2563EB] shadow-xl shadow-purple-600/25 active:scale-95 transition"
            >
              <span>查看全部教程</span>
              <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
            <a
              href="/contact/"
              class="inline-flex items-center gap-2 px-8 py-4 rounded-full text-base font-bold text-slate-800 bg-white hover:bg-slate-50 border border-slate-200/90 shadow-md shadow-slate-200/50 hover:border-purple-300 active:scale-95 transition"
            >
              <span>委托建站咨询</span>
              <span class="text-purple-600 font-black">→</span>
            </a>
          </div>

          <!-- Stats Strip -->
          <div class="pt-8 border-t border-slate-200/80 grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6">
            {stats.map((s) => (
              <div class="p-3 rounded-2xl bg-white/60 border border-slate-100 backdrop-blur-xs">
                <div class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">{s.value}</div>
                <div class="text-xs font-medium text-slate-500 mt-0.5">{s.label}</div>
              </div>
            ))}
          </div>
        </div>

        <!-- Right Hero Mockup: High-Contrast Creative Studio Window -->
        <div class="lg:col-span-5 relative">
          <!-- Window Outer Shadow and Border -->
          <div class="relative rounded-3xl p-3 bg-gradient-to-b from-slate-800 to-slate-950 shadow-2xl shadow-purple-950/25 border border-slate-700/60 overflow-hidden">
            <!-- Studio Dark App Chrome Header -->
            <div class="flex items-center justify-between px-3 py-2 border-b border-slate-800 bg-slate-900/90 rounded-t-2xl text-xs">
              <div class="flex items-center gap-1.5">
                <div class="w-3 h-3 rounded-full bg-[#EF4444]"></div>
                <div class="w-3 h-3 rounded-full bg-[#F59E0B]"></div>
                <div class="w-3 h-3 rounded-full bg-[#10B981]"></div>
              </div>

              <!-- Breakpoint Switcher Pills -->
              <div class="flex items-center gap-1 bg-slate-800 p-1 rounded-xl border border-slate-700">
                <span class="px-2 py-0.5 rounded-lg bg-[#7C3AED] text-white text-[10px] font-bold flex items-center gap-1">
                  <span>1920 桌面端</span>
                </span>
                <span class="px-2 py-0.5 text-slate-400 text-[10px]">平板</span>
                <span class="px-2 py-0.5 text-slate-400 text-[10px]">移动端</span>
              </div>

              <!-- Status badge -->
              <div class="flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 text-[10px] font-bold">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>已上线</span>
              </div>
            </div>

            <!-- Workspace Editor Layout -->
            <div class="flex bg-slate-950 rounded-b-2xl overflow-hidden min-h-[320px]">
              <!-- Left Tool Rail with Clean Vector Icons (No Emojis) -->
              <div class="w-11 border-r border-slate-800 bg-slate-900/70 py-3 flex flex-col items-center gap-3 text-slate-400 text-xs">
                <span class="w-7 h-7 rounded-lg flex items-center justify-center bg-[#7C3AED] text-white font-black cursor-pointer shadow-md">+</span>
                <span class="p-1 rounded hover:text-white cursor-pointer"><Icon name="layout" class="w-4 h-4" /></span>
                <span class="p-1 rounded hover:text-white cursor-pointer"><Icon name="palette" class="w-4 h-4" /></span>
                <span class="p-1 rounded hover:text-white cursor-pointer"><Icon name="layers" class="w-4 h-4" /></span>
                <span class="p-1 rounded hover:text-purple-400 font-mono font-bold text-xs text-purple-400 cursor-pointer">{ }</span>
              </div>

              <!-- Center Interactive Canvas Simulator -->
              <div class="flex-1 p-5 relative flex flex-col justify-between bg-gradient-to-br from-slate-900 via-slate-950 to-[#1e1438]">
                <!-- Active Visual Element Selection Frame -->
                <div class="border-2 border-[#8B5CF6] rounded-2xl p-5 relative bg-slate-900/90 shadow-2xl backdrop-blur-md">
                  <!-- Responsive resize handles -->
                  <div class="w-3 h-3 rounded-full bg-[#8B5CF6] absolute -top-1.5 -left-1.5 border-2 border-white shadow-sm"></div>
                  <div class="w-3 h-3 rounded-full bg-[#8B5CF6] absolute -top-1.5 -right-1.5 border-2 border-white shadow-sm"></div>
                  <div class="w-3 h-3 rounded-full bg-[#8B5CF6] absolute -bottom-1.5 -left-1.5 border-2 border-white shadow-sm"></div>
                  <div class="w-3 h-3 rounded-full bg-[#8B5CF6] absolute -bottom-1.5 -right-1.5 border-2 border-white shadow-sm"></div>

                  <div class="flex items-center justify-between mb-3">
                    <span class="text-[10px] uppercase font-mono px-2.5 py-0.5 rounded-full bg-purple-500/25 text-purple-300 font-bold border border-purple-500/30">
                      Fluid: 等比缩放 100%
                    </span>
                    <span class="text-[10px] text-slate-400 font-mono">12 列 CSS 网格</span>
                  </div>

                  <div class="space-y-2.5">
                    <div class="h-3 w-1/3 rounded-full bg-purple-400/80"></div>
                    <div class="h-6 w-5/6 rounded-lg bg-gradient-to-r from-white via-slate-100 to-slate-400 font-bold"></div>
                    <div class="h-2.5 w-1/2 rounded-full bg-slate-600"></div>
                  </div>

                  <div class="mt-4 flex items-center gap-2">
                    <span class="px-3.5 py-1 rounded-full text-xs font-bold bg-[#7C3AED] text-white shadow-md">品牌案例</span>
                    <span class="px-3.5 py-1 rounded-full text-xs font-semibold border border-slate-600 text-slate-300 bg-slate-800">在线交互</span>
                  </div>
                </div>

                <!-- Bottom Status info -->
                <div class="mt-4 flex items-center justify-between text-[11px] text-slate-400 font-mono border-t border-slate-800/80 pt-2">
                  <span>断点: 响应式流体引擎</span>
                  <span class="text-purple-400 font-bold">Velo: Connected</span>
                </div>
              </div>
            </div>

            <!-- Floating Wix Partner Legend Badge Seal -->
            <div class="absolute -bottom-4 -right-4 w-22 h-22 sm:w-26 sm:h-26 z-20 transition-transform hover:scale-105">
              <div class="relative w-full h-full">
                <div class="absolute inset-0 rounded-full bg-purple-500 blur-xl opacity-50 animate-pulse"></div>
                <img
                  src="/assets/badges/wix-partner-legend-200.png"
                  alt="Wix Partner Legend"
                  width="104"
                  height="104"
                  class="relative rounded-full border-4 border-slate-900 shadow-2xl shadow-black/80"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Rich Platform Marquee with SVG Icons (Zero Emojis) -->
  <section class="border-y border-slate-200 bg-slate-50/80 py-6 overflow-hidden">
    <div class="marquee-mask">
      <div class="animate-marquee-scroll items-center gap-6 whitespace-nowrap">
        {platforms.concat(platforms).map((p) => (
          <div class={`inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-bold border shadow-xs bg-white ${p.color}`}>
            <Icon name={p.icon} class="w-4 h-4" />
            <span>{p.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 3: Tutorials Cards Grid with Vector SVG Icons -->
  <section class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
      <div class="inline-block text-xs font-black uppercase tracking-widest text-[#6D28D9] px-4 py-1.5 rounded-full bg-purple-50 border border-purple-200/90 shadow-xs">
        TUTORIALS 教程体系
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
        从零开始学 Wix Studio
      </h2>
      <p class="text-base sm:text-lg text-slate-600">
        循序渐进的系统化中文课程，覆盖从基础搭建、高阶设计到代码扩展全流程。
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {tutorials.map((card) => (
        <a
          href={card.href}
          class="premium-card p-8 group flex flex-col justify-between block relative"
        >
          <!-- Top Colored Accent Stripe on Hover -->
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#6D28D9] to-[#2563EB] opacity-0 group-hover:opacity-100 transition-opacity"></div>

          <div class="space-y-5">
            <div class="flex items-center justify-between">
              <div class={`w-14 h-14 rounded-2xl bg-gradient-to-br ${card.iconBg} text-white flex items-center justify-center text-2xl group-hover:scale-110 transition-transform shadow-lg shadow-slate-200`}>
                <Icon name={card.icon} class="w-7 h-7" />
              </div>
              <span class={`text-[11px] font-bold uppercase tracking-wider px-3 py-1 rounded-full border ${card.tagColor}`}>
                {card.tag}
              </span>
            </div>
            <h3 class="text-xl font-extrabold text-slate-900 group-hover:text-[#6D28D9] transition">
              {card.title}
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              {card.desc}
            </p>
          </div>

          <div class="pt-6 mt-6 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-slate-700 group-hover:text-[#6D28D9] transition">
            <span>进入专栏学习</span>
            <span class="transform group-hover:translate-x-1.5 transition-transform text-purple-600 text-sm">→</span>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-14 text-center">
      <a
        href="/tutorials/"
        class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full text-sm font-bold text-slate-700 hover:text-slate-900 bg-white border border-slate-300 hover:border-purple-300 shadow-md shadow-slate-200/50 hover:shadow-lg transition"
      >
        <span>查看全部 35+ 篇系统教程大纲</span>
        <span class="text-purple-600">→</span>
      </a>
    </div>
  </section>

  <!-- Section 4: High-Contrast Midnight Navy Compare Section -->
  <section class="py-24 bg-[#0B0F19] text-white relative overflow-hidden border-y border-slate-800">
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-purple-600/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-blue-600/20 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-4 space-y-5">
          <div class="inline-block text-xs font-black uppercase tracking-widest text-purple-400 px-3.5 py-1 rounded-full bg-purple-500/20 border border-purple-500/30">
            COMPARISONS 选型横评
          </div>
          <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
            选对建站平台<br />
            <span class="text-gradient-purple">事半功倍</span>
          </h2>
          <p class="text-sm text-slate-400 leading-relaxed">
            不知道是用 Wix、Shopify 还是 WordPress？我们以中国企业和出海卖家的真实业务场景为准绳，为您做客观深度的剖析横评。
          </p>
          <div class="pt-2">
            <a
              href="/compare/"
              class="inline-flex items-center gap-1.5 text-sm font-bold text-purple-400 hover:text-purple-300 hover:underline"
            >
              <span>查看 5 大主流建站平台综合横评报告</span>
              <span>→</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-8 space-y-4">
          {compareItems.map((item) => (
            <a
              href={item.href}
              class="p-6 rounded-2xl block group border border-slate-800 bg-slate-900/80 hover:border-purple-500/60 hover:bg-slate-900 transition-all shadow-xl"
            >
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-4 border-b border-slate-800">
                <div class="flex items-center gap-3">
                  <h3 class="text-lg font-bold text-white group-hover:text-purple-300 transition">
                    {item.name}
                  </h3>
                  <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-300 border border-slate-700">
                    {item.badge}
                  </span>
                </div>
                <span class="text-xs font-bold text-purple-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                  查看深度对比报告 →
                </span>
              </div>
