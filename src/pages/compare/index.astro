---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroListing from '../../components/HeroListing.astro';
import Icon from '../../components/Icon.astro';

interface PlatformEvaluation {
  stars: number;
  score: string;
  tag: string;
  title: string;
  desc: string;
}

interface DimensionRow {
  dimension: string;
  advantage: string;
  wix: PlatformEvaluation;
  shopify: PlatformEvaluation;
  wordpress: PlatformEvaluation;
  webflow: PlatformEvaluation;
  squarespace: PlatformEvaluation;
}

const dimensionMatrix: DimensionRow[] = [
  {
    dimension: '视觉排版与流体响应式',
    advantage: '兼顾极致视觉设计与极速交付',
    wix: {
      stars: 5,
      score: '5.0',
      tag: '行业标杆',
      title: '独创等比流体引擎（Fluid Engine）',
      desc: '支持 Scale Proportionally 比例等比缩放、9 点智能停靠（Docking）与无代码 CSS Grid，实现像素级精准控制。',
    },
    shopify: {
      stars: 3,
      score: '3.0',
      tag: '模块骨架',
      title: '基于 Liquid 预设模板',
      desc: '页面布局受限于固定条状 Section 框架，跨端响应式排版如需定制必须直接手写 Liquid 代码。',
    },
    wordpress: {
      stars: 3,
      score: '3.0',
      tag: '依赖外挂',
      title: '依赖 Elementor / Divi',
      desc: '虽然支持可视化拖拽，但生成多达 8~12 层无意义 DOM 嵌套，跨端极易发生样式错位与代码冲突。',
    },
    webflow: {
      stars: 4,
      score: '4.0',
      tag: '手写代码',
      title: '严格前端 CSS 盒模型',
      desc: '视觉还原度极高，但每个断点都需要人工配置 Class 继承关系与手写布局，排版工时高出 50%+。',
