    shopify: {
      stars: 4,
      score: '4.0',
      tag: '多币种佳',
      title: 'Shopify Markets 跨国结算',
      desc: '国际货币与运费换算成熟，但高级多语言翻译与子域名往往需要单独付费购买应用。',
    },
    wordpress: {
      stars: 3,
      score: '3.0',
      tag: '插件繁琐',
      title: '需依赖 WPML / Yoast 插件',
      desc: '需配置重型多语言插件，容易在数据库中产生海量冗余表，导致后台卡顿与翻译串行。',
    },
    webflow: {
      stars: 3,
      score: '3.0',
      tag: '额外按月',
      title: 'Localization 功能单独按月收费',
      desc: '官方多语言功能配置门槛高，且每个语种单独按月加价收费，长期支出昂贵。',
    },
    squarespace: {
      stars: 2,
      score: '2.0',
      tag: '较初级',
      title: '多语言支持较为初级',
      desc: '通常需依赖第三方翻译插件（如 Weglot），对复杂出海 SEO 本地化缺乏灵活度。',
    },
  },
  {
    dimension: '综合拥有成本 (TCO) 与交付周期',
    advantage: '交付提速 40%-50%，年省数万元维护费',
    wix: {
      stars: 5,
      score: '5.0',
      tag: '最高 ROI',
      title: '透明年费订阅一价全包',
      desc: '含高性能云主机、全球 CDN、全套商业应用与流体引擎，交付周期缩短 40%-50%，年均省数万元技术工时。',
    },
    shopify: {
      stars: 3,
      score: '3.0',
      tag: '隐形成本',
      title: '套餐费 + 交易抽成 + App月租',
      desc: '实际运营中大量月租 App 与外部支付扣点使得每年的真实支出远超预期账单。',
    },
    wordpress: {
      stars: 2,
      score: '2.0',
      tag: '沉没成本',
      title: '服务器 + 插件年费 + 运维工时',
      desc: '表面免费，但持续的主机、WAF 防火墙、插件商业授权与外包维护排障成本极高。',
    },
    webflow: {
      stars: 3,
      score: '3.0',
      tag: '席位昂贵',
      title: '团队席位费 + 站点计划',
      desc: '多成员协作席位费昂贵，加上外接第三方支付与表单插件，综合持有成本偏高。',
    },
    squarespace: {
      stars: 4,
      score: '4.0',
      tag: '资费固定',
      title: '资费透明但存在业务天花板',
      desc: '适合预算极其明确的小型个人展示站，但业务发展到第二阶段时缺乏平滑演进空间。',
    },
  },
];

