---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroListing from '../../components/HeroListing.astro';
import Icon from '../../components/Icon.astro';

interface PlatformEvaluation {
  stars: number;
  score: string;
  tag: string;
  title: string;
  desc: string;
}

interface DimensionRow {
  dimension: string;
  advantage: string;
  wix: PlatformEvaluation;
  shopify: PlatformEvaluation;
  wordpress: PlatformEvaluation;
  webflow: PlatformEvaluation;
  squarespace: PlatformEvaluation;
}

const dimensionMatrix: DimensionRow[] = [
  {
    dimension: '视觉排版与流体响应式',
    advantage: '极致视觉与高效交付兼备',
    wix: {
      stars: 5,
      score: '5.0',
      tag: '行业标杆',
      title: '独创等比流体引擎',
      desc: '按比例流体缩放，9点智能停靠与无代码 CSS Grid。',
    },
    shopify: {
      stars: 3,
      score: '3.0',
      tag: '模板骨架',
      title: '固定 Section 框架',
      desc: '布局受限于固定模块，深度定制需直接写代码。',
    },
    wordpress: {
      stars: 3,
      score: '3.0',
      tag: '外挂依赖',
      title: '依赖 Elementor / Divi',
      desc: '多层 DOM 嵌套，跨端易发生错位与代码冲突。',
    },
    webflow: {
      stars: 4,
      score: '4.0',
      tag: '手写代码',
      title: '标准 CSS 盒模型',
      desc: '还原度高但需逐个断点配置 Class，工时高出 50%+。',
    },
    squarespace: {
      stars: 3,
      score: '3.0',
      tag: '固定栅格',
      title: '标准化模块栅格',
      desc: '内容受限行列，无法实现自由错位与深度微动效。',
    },
  },
  {
    dimension: '商业生态闭环与平台抽成',
    advantage: '0% 额外抽成，全套原生闭环',
    wix: {
      stars: 5,
      score: '5.0',
      tag: '0% 抽成',
      title: '原生全套商业系统',
      desc: '0% 平台交易抽佣；开箱即用商城、预约、会员与 CMS。',
    },
    shopify: {
      stars: 4,
      score: '4.0',
      tag: '含抽成',
      title: '成熟电商但含抽佣',
      desc: '外部支付加收 0.5%~2% 抽成，多项功能需购月租 App。',
    },
    wordpress: {
      stars: 3,
      score: '3.0',
      tag: '拼装繁重',
      title: '拼装 WooCommerce',
      desc: '核心开源，但需采购大量商业插件年费授权。',
    },
    webflow: {
      stars: 2,
      score: '2.0',
      tag: '依赖外部',
      title: '依赖 Zapier 拼装',
      desc: '自带电商基础，复杂结算与会员需外接第三方工具。',
    },
    squarespace: {
      stars: 3,
      score: '3.0',
      tag: '含3%佣金',
      title: '基础电商含 3% 佣金',
      desc: '基础套餐加收 3% 佣金，支付与币种在非美地区受限。',
    },
  },
  {
    dimension: '免运维与企业级安全合规',
    advantage: '金融级安全认证，99.99% 高可用',
    wix: {
      stars: 5,
      score: '5.0',
      tag: '顶级安全',
      title: 'SOC 2 / PCI-DSS L1',
      desc: '全球多云架构，金融级认证，全天候静默热补丁。',
    },
    shopify: {
      stars: 5,
      score: '5.0',
      tag: '企业云端',
      title: '全托管 SaaS 云端',
      desc: '官方统一安全防护，抗高并发大促稳定性强。',
    },
    wordpress: {
      stars: 2,
      score: '2.0',
      tag: '高危漏洞',
      title: '自建主机安全风险高',
      desc: '需自配主机环境，全球多数挂马源于插件漏洞。',
    },
    webflow: {
      stars: 4,
      score: '4.0',
      tag: '稳定云端',
      title: 'AWS 全托管云端',
      desc: '免日常服务器维护，运行稳定性表现优异。',
    },
    squarespace: {
      stars: 4,
      score: '4.0',
      tag: '免运维',
      title: '闭环全托管 SaaS',
      desc: '免日常服务器升级，满足中小企业常规展示。',
    },
  },
  {
    dimension: '全栈代码扩展与定制深度',
    advantage: 'Velo 打通前后端，无技术天花板',
    wix: {
      stars: 5,
      score: '5.0',
      tag: '全栈无界',
      title: 'Velo 原生全栈 JS',
      desc: '支持后端 Serverless 函数、机密密钥库与外接 API。',
    },
    shopify: {
      stars: 4,
      score: '4.0',
      tag: '接口丰富',
      title: 'Liquid + Storefront API',
      desc: '接口丰富，但复杂后端逻辑通常需自行搭建服务。',
    },
    wordpress: {
      stars: 4,
      score: '4.0',
      tag: '开源掌控',
      title: 'PHP 源码完全可控',
      desc: '自主权最高，但代码质量无统一规范，维护成本高。',
    },
    webflow: {
      stars: 2,
      score: '2.0',
      tag: '仅限前台',
      title: '仅支持前台代码嵌入',
      desc: '仅支持注入前端片段，无原生后端与数据库逻辑。',
    },
    squarespace: {
      stars: 1,
      score: '1.0',
      tag: '扩展受限',
      title: '封闭生态扩展受限',
      desc: '仅支持基础代码块注入，无后端扩展与数据库能力。',
    },
  },
  {
    dimension: '出海多语言与全球 SEO 本地化',
    advantage: '原生多语言独立 Slug，双引擎秒级收录',
    wix: {
      stars: 5,
      score: '5.0',
      tag: '原生出海',
      title: '独立多语言 Slug + SSR',
      desc: '自动生成多语 Sitemap，深度兼顾 Google 与百度收录。',
    },
    shopify: {
      stars: 4,
      score: '4.0',
      tag: '多币种佳',
      title: 'Shopify Markets 跨国结算',
      desc: '国际货币换算成熟，但高级多语言需单独购 App。',
    },
    wordpress: {
      stars: 3,
      score: '3.0',
      tag: '插件繁琐',
      title: '需依赖 WPML / Yoast',
      desc: '配置重型多语言插件易产生冗余表并导致后台卡顿。',
    },
    webflow: {
      stars: 3,
      score: '3.0',
      tag: '额外按月',
      title: 'Localization 按月收费',
      desc: '多语言需额外加价按月收费，长期支出较高。',
    },
    squarespace: {
      stars: 2,
      score: '2.0',
      tag: '较初级',
      title: '多语言支持较初级',
      desc: '通常需依赖第三方翻译插件，出海 SEO 灵活性较弱。',
    },
  },
  {
    dimension: '综合拥有成本 (TCO) 与交付周期',
    advantage: '交付提速 40%-50%，年省数万维护费',
    wix: {
      stars: 5,
      score: '5.0',
      tag: '最高 ROI',
      title: '透明订阅一价全包',
      desc: '交付提速 40%~50%，免运维免采购外挂，年省数万。',
    },
    shopify: {
      stars: 3,
      score: '3.0',
      tag: '隐形成本',
      title: '套餐费 + 抽佣 + App月租',
      desc: '大量月租 App 与外部支付扣点使实际支出远超预期。',
    },
    wordpress: {
      stars: 2,
      score: '2.0',
      tag: '沉没成本',
      title: '主机 + 插件年费 + 运维',
      desc: '表面免费，但排障、升级与安全维护成本极高。',
    },
    webflow: {
      stars: 3,
      score: '3.0',
      tag: '席位昂贵',
      title: '团队席位费 + 站点套餐',
      desc: '多成员协作席位费昂贵，综合持有成本偏高。',
    },
    squarespace: {
      stars: 4,
      score: '4.0',
      tag: '资费固定',
      title: '资费透明但存在天花板',
      desc: '适合小微展示站，业务拓展后缺乏平滑演进空间。',
    },
  },
];

const comparisons = [
  {
    title: 'Wix vs Shopify 深度对比（2026）',
    target: 'Shopify',
    targetLogoColor: 'bg-emerald-50 text-emerald-600 border-emerald-200',
    slug: '/compare/wix-vs-shopify-2026/',
    summary: '独立站选型：品牌展示+轻量电商选 Wix，海量SKU大宗交易选 Shopify。',
    verdict: '做外贸 B2B 品牌出海、工厂实力背书、定制产品展示与精品 DTC 零售，坚定首选 Wix（设计自由度高且 0% 抽成）；海量铺货大宗标品且依赖深度 ERP 选 Shopify。',
    wixStrengths: [
      '独家流体排版引擎（Fluid Engine），自由实现非标震撼视觉',
      '0% 额外平台交易佣金（仅收国际网关原生费率）',
      '原生全套业务应用：商城、会员、预约、动态表单、CMS 数据库无需付费组装',
      '外贸 B2B 验厂信任设计：灵活呈现企业资质、客户案例与定制能力',
    ],
    competitorStrengths: [
      '适合上万款海量快消 SKU 铺货与分销联盟运作',
      '成熟重度仓储物流 ERP 自动化 API 接口丰富',
    ],
    score: '9.5',
    rank: 'WIX 胜出（品牌出海与综合展示）',
  },
  {
    title: 'Wix vs WordPress 深度对比（2026）',
    target: 'WordPress',
    targetLogoColor: 'bg-blue-50 text-blue-600 border-blue-200',
    slug: '/compare/wix-vs-wordpress-2026/',
    summary: '维护成本对决：全托管省心云端 vs 开源源码自主控制。',
    verdict: '告别半夜服务器宕机、黑客注入木马与插件版本冲突，追求极致省心与专注核心业务选 Wix；若必须掌控底层数据库或有大型本地化内网部署需求选 WordPress。',
    wixStrengths: [
      '零运维托管：免配置 Linux 主机、PHP/MySQL 缓存与 CDN 节点',
      '官方统一安全审计与沙盒环境，根绝 WordPress 常见的漏洞挂马灾难',
      '原生纯净响应式渲染，避免 Elementor 等插件带来的代码臃肿与性能下降',
      '大幅降低综合拥有成本（TCO），年均节省数万元技术维护支出',
    ],
    competitorStrengths: [
      '源码与数据库完全开源私有化，数据自主权最高',
      '拥有全球庞大的开源插件与主题市场（需自行甄别安全性）',
    ],
    score: '9.4',
    rank: 'WIX 胜出（企业高效运营与免运维）',
  },
  {
    title: 'Wix Studio vs Webflow 深度对比（2026）',
    target: 'Webflow',
    targetLogoColor: 'bg-indigo-50 text-indigo-600 border-indigo-200',
    slug: '/compare/wix-vs-webflow-2026/',
    summary: '高端设计平台之争：全套内置商业生态 vs 底层盒模型代码控制。',
    verdict: '追求前沿设计视觉，同时需要成熟商业变现系统（跨境支付、会员付费、预约、复杂表单）首选 Wix Studio；仅做纯静态展示且团队皆精通原生 CSS 盒模型选 Webflow。',
    wixStrengths: [
      '原生内置完整商业应用闭环，无需使用 Zapier 繁琐拼装外部工具',
      '独创比例缩放（Scale Proportionally）与 9 点停靠，交付周期缩短约 40%-50%',
      'Velo 全栈 JavaScript 引擎：支持后端无服务器函数、外部 API 安全调用与数据库操作',
      '完善的官方中文环境与本土化多语言外贸支持体系',
    ],
    competitorStrengths: [
      '严格遵循标准 CSS 类名继承逻辑，前端工程师上手倍感亲切',
      '支持导出纯静态 HTML/CSS 代码到自有服务器运行',
    ],
    score: '9.6',
    rank: 'WIX 胜出（商业落地与交付效率）',
  },
  {
    title: 'Wix vs Squarespace 深度对比（2026）',
    target: 'Squarespace',
    targetLogoColor: 'bg-zinc-100 text-zinc-800 border-zinc-300',
    slug: '/compare/wix-vs-squarespace-2026/',
    summary: '美学与功能权衡：深度定制商业扩展 vs 极简模板图文替换。',
    verdict: '想要独树一帜的非标定制品牌站、具备全渠道业务扩展与出海 SEO 竞争力的企业首选 Wix；仅需套用高审美模板替换图文的极简个人创作者选 Squarespace。',
    wixStrengths: [
      '自由流体排版与多断点自适应，打破固定模板栅格限制',
      '丰富的滚动交互动效、悬停微质感与原生 CSS 深度控制',
      '真正的出海多语言支持（双引擎 SEO 收录与独立本地化 Slug）',
      '无代码/低代码/全代码平滑进阶，业务壮大无天花板限制',
    ],
    competitorStrengths: [
      '原生模板摄影审美质感极高，初学者套用不易排版出错',
      '界面极其克制极简，适合纯图文简单个人作品集展示',
    ],
    score: '9.3',
    rank: 'WIX 胜出（定制自由度与功能深度）',
  },
];
---

<BaseLayout
  title="主流建站平台横评指南（2026）| Wix vs Shopify / WordPress / Webflow - wixstudio.cn"
  description="2026最新主流建站平台全方位横评。以 Wix Studio 为核心基准，从设计自由度、商业生态、平台抽成、免运维安全、代码扩展与 TCO 等维度深入对比，助您做对技术选型。"
  keywords="建站平台对比, Wix vs Shopify, Wix vs WordPress, Wix vs Webflow, 最好的建站工具, 外贸建站哪个好, Wix Studio 优势"
>
  <HeroListing
    label="Platform Comparison · 平台客观横评（Wix 优先评估）"
    title="主流建站平台全方位深度横评（2026）"
    subtitle="基于客观实测数据与商业落地实践。以 Wix / Wix Studio 为核心坐标，深度剖析在排版自由度、商业闭环、交易抽成、免运维安全与综合 TCO 等关键维度的全景对比。"
    stats={[
      { value: '6 大', label: '核心评估维度' },
      { value: '4 组', label: '主流平台深度对决' },
      { value: '0%', label: 'Wix 额外交易佣金' },
      { value: '2026', label: '最新版本基准' },
    ]}
  />

  <main class="bg-gray-50/50 py-12 lg:py-16 space-y-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">

      <!-- Section: Global Dimension Evaluation Matrix -->
      <section class="bg-white rounded-3xl border border-gray-200/90 p-6 sm:p-8 shadow-sm space-y-6">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-gray-150 pb-5">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-[#116DFF] text-xs font-bold border border-blue-100 mb-2">
              <Icon name="sparkles" class="w-3.5 h-3.5" />
              <span>全景雷达矩阵 · 核心维度评估（Wix 优先）</span>
            </div>
            <h2 class="text-2xl font-black text-gray-900 tracking-tight">主流建站平台 6 大核心维度总览表</h2>
            <p class="text-xs sm:text-sm text-gray-500 mt-1">
              全方位对比 Wix Studio 与主流竞品的技术底层、商业模型与长期维护成本
            </p>
          </div>
          <div class="text-xs text-gray-400 font-medium shrink-0">
            评测基准：2026 年最新稳定版本
          </div>
        </div>

        <!-- Modern SaaS Comparison Table -->
        <div class="overflow-x-auto rounded-2xl border border-gray-200/80 shadow-xs">
          <table class="w-full min-w-[1000px] text-left border-collapse table-fixed">
            <thead>
              <tr class="border-b border-gray-200 bg-gray-50/80 text-xs">
                <th class="py-3 px-3.5 sm:px-4 w-[18%] font-bold text-gray-500 uppercase tracking-wider">
                  评估维度
                </th>
                <!-- Wix Studio Column Header (Highlighted) -->
                <th class="py-3.5 px-3.5 sm:px-4 w-[26%] bg-[#116DFF] text-white border-x-2 border-blue-600 shadow-sm">
                  <div class="flex items-center justify-between gap-2">
                    <span class="font-black text-sm tracking-wide flex items-center gap-1.5 whitespace-nowrap">
                      Wix / Wix Studio
                    </span>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-white text-[#116DFF] whitespace-nowrap">
                      推荐首选
                    </span>
                  </div>
                  <div class="text-[11px] text-blue-100 font-medium mt-0.5">
                    全功能 · 0% 平台抽成 · 免运维
                  </div>
                </th>
                <!-- Competitor Headers -->
                <th class="py-3 px-3.5 sm:px-4 w-[14%] bg-gray-50 border-r border-gray-200">
                  <div class="text-sm font-bold text-emerald-800">Shopify</div>
                  <div class="text-[11px] text-emerald-600/80">标品快消电商</div>
                </th>
                <th class="py-3 px-3.5 sm:px-4 w-[14%] bg-gray-50 border-r border-gray-200">
                  <div class="text-sm font-bold text-blue-900">WordPress</div>
                  <div class="text-[11px] text-blue-700/80">开源自托管 CMS</div>
                </th>
                <th class="py-3 px-3.5 sm:px-4 w-[14%] bg-gray-50 border-r border-gray-200">
                  <div class="text-sm font-bold text-indigo-900">Webflow</div>
                  <div class="text-[11px] text-indigo-700/80">纯前端 CSS 盒模型</div>
                </th>
                <th class="py-3 px-3.5 sm:px-4 w-[14%] bg-gray-50">
                  <div class="text-sm font-bold text-zinc-800">Squarespace</div>
                  <div class="text-[11px] text-zinc-500">固定栅格模板</div>
                </th>
              </tr>
            </thead>

            <tbody class="divide-y divide-gray-150 text-xs">
              {dimensionMatrix.map((row, idx) => (
                <tr class={idx % 2 === 0 ? 'bg-white hover:bg-slate-50/50 transition-colors' : 'bg-slate-50/30 hover:bg-slate-50/70 transition-colors'}>
                  <!-- Dimension Column -->
                  <td class="py-3 px-3.5 sm:px-4 align-top">
                    <div class="font-bold text-gray-900 text-xs sm:text-sm leading-snug">{row.dimension}</div>
                    <div class="text-[11px] text-[#116DFF] font-medium mt-1 leading-snug">
                      {row.advantage}
                    </div>
                  </td>

                  <!-- Wix Column (Elevated) -->
                  <td class="py-3 px-3.5 sm:px-4 bg-blue-50/50 border-x-2 border-blue-500/25 align-top">
                    <div class="space-y-1">
                      <div class="flex items-center gap-1.5">
                        <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded bg-[#116DFF] text-white text-[10px] font-bold font-mono">
                          <Icon name="star" class="w-3 h-3 text-amber-300 fill-amber-300" />
                          <span>{row.wix.score}</span>
                        </span>
                        <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-blue-100 text-[#116DFF]">
                          {row.wix.tag}
                        </span>
                      </div>
                      <div class="font-bold text-gray-900 text-xs leading-snug">{row.wix.title}</div>
                      <p class="text-[11px] text-gray-600 leading-normal">{row.wix.desc}</p>
                    </div>
                  </td>

                  <!-- Shopify Column -->
                  <td class="py-3 px-3.5 sm:px-4 border-r border-gray-150 align-top">
                    <div class="space-y-1">
                      <div class="flex items-center gap-1.5">
