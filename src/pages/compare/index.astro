    },
    webflow: {
      stars: 4,
      score: '4.0',
      tag: '稳定云端',
      title: 'AWS 全球云端基础设施',
      desc: '全托管云端，免日常服务器维护，运行稳定性良好。',
    },
    squarespace: {
      stars: 4,
      score: '4.0',
      tag: '免运维',
      title: '闭环全托管 SaaS',
      desc: '免去日常服务器升级维护，合规性基本满足常规中小企业展示需求。',
    },
  },
  {
    dimension: '全栈代码扩展与定制深度',
    advantage: 'Velo 原生打通前后端，无技术天花板',
