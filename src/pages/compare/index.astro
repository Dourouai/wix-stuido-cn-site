---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroListing from '../../components/HeroListing.astro';
import Icon from '../../components/Icon.astro';

interface PlatformEvaluation {
  score: string;
  tag: string;
  text: string;
}

interface DimensionRow {
  dimension: string;
  advantage: string;
  wix: PlatformEvaluation;
  shopify: PlatformEvaluation;
  wordpress: PlatformEvaluation;
  webflow: PlatformEvaluation;
  squarespace: PlatformEvaluation;
}

const dimensionMatrix: DimensionRow[] = [
  {
    dimension: '视觉排版与流体响应式',
    advantage: '极致视觉与高效交付兼备',
    wix: {
      score: '5.0',
      tag: '行业标杆',
      text: '等比流体缩放，免代码自由像素排版',
    },
    shopify: {
      score: '3.0',
      tag: '模板骨架',
      text: '固定条状框架，深度排版需手写代码',
    },
    wordpress: {
      score: '3.0',
      tag: '外挂依赖',
      text: '依赖 Elementor 等插件，易错位冲突',
    },
    webflow: {
      score: '4.0',
      tag: '手写代码',
      text: '严格 CSS 盒模型，各端需手写 Class',
    },
    squarespace: {
      score: '3.0',
      tag: '固定栅格',
      text: '固定行列栅格，无法自由错位交叠',
    },
  },
  {
    dimension: '商业生态闭环与平台抽成',
    advantage: '0% 额外抽成，全套原生闭环',
    wix: {
      score: '5.0',
      tag: '0% 抽成',
      text: '0% 平台抽佣，原生全套应用闭环',
    },
    shopify: {
      score: '4.0',
      tag: '含抽成',
      text: '加收 0.5%~2% 交易费，依赖月租 App',
    },
    wordpress: {
      score: '3.0',
      tag: '拼装繁重',
      text: '核心开源，但商业插件年费高昂',
    },
    webflow: {
      score: '2.0',
      tag: '依赖外部',
      text: '自带电商基础，复杂结算需外接工具',
    },
    squarespace: {
      score: '3.0',
      tag: '含3%佣金',
      text: '加收 3% 平台佣金，多币种支持有限',
    },
  },
  {
    dimension: '免运维与企业级安全合规',
    advantage: '金融级安全认证，99.99% 高可用',
    wix: {
      score: '5.0',
      tag: '顶级安全',
      text: 'SOC 2 / PCI-DSS L1 全托管免维护',
    },
    shopify: {
      score: '5.0',
      tag: '企业云端',
      text: '全托管 SaaS 云端，高并发大促保障',
    },
    wordpress: {
      score: '2.0',
      tag: '高危漏洞',
      text: '自建主机安全风险高，插件漏洞易被黑',
    },
    webflow: {
      score: '4.0',
      tag: '稳定云端',
      text: 'AWS 云端托管，免服务器日常运维',
    },
    squarespace: {
      score: '4.0',
      tag: '免运维',
      text: '闭环全托管 SaaS，免日常服务器升级',
    },
  },
  {
    dimension: '全栈代码扩展与定制深度',
    advantage: 'Velo 打通前后端，无技术天花板',
    wix: {
      score: '5.0',
      tag: '全栈无界',
      text: 'Velo 全栈 JS，内置 Serverless 与 API',
    },
    shopify: {
      score: '4.0',
      tag: '接口丰富',
      text: 'Liquid + 接口成熟，复杂后端需自建',
    },
    wordpress: {
      score: '4.0',
      tag: '开源掌控',
      text: 'PHP 完全开源，但代码质量缺乏统一规范',
    },
    webflow: {
      score: '2.0',
      tag: '仅限前台',
      text: '仅限前端代码嵌入，无原生后端逻辑',
    },
    squarespace: {
      score: '1.0',
      tag: '扩展受限',
      text: '仅基础代码块注入，无后端扩展能力',
    },
  },
  {
    dimension: '出海多语言与全球 SEO 本地化',
    advantage: '原生多语言独立 Slug，双引擎秒级收录',
    wix: {
      score: '5.0',
      tag: '原生出海',
      text: '独立多语 Slug，双引擎 SSR 秒级收录',
    },
    shopify: {
      score: '4.0',
      tag: '多币种佳',
      text: '多币种结算成熟，高级多语言需单独购 App',
    },
    wordpress: {
      score: '3.0',
      tag: '插件繁琐',
      text: '外挂多语言插件配置繁琐，易卡顿冗余',
    },
    webflow: {
      score: '3.0',
      tag: '额外按月',
      text: 'Localization 多语言功能高额按月加价',
    },
    squarespace: {
      score: '2.0',
      tag: '较初级',
      text: '多语言支持较初级，出海灵活度不足',
    },
  },
  {
    dimension: '综合拥有成本 (TCO) 与交付周期',
    advantage: '交付提速 40%-50%，年省数万维护费',
    wix: {
      score: '5.0',
      tag: '最高 ROI',
      text: '一价全包订阅，交付提速 40%~50%，年省数万',
    },
    shopify: {
      score: '3.0',
      tag: '隐形成本',
      text: '套餐 + 抽成 + App 月租累加，隐形成本高',
    },
    wordpress: {
      score: '2.0',
      tag: '沉没成本',
      text: '主机 + 插件年费 + 持续人工运维排障',
    },
    webflow: {
      score: '3.0',
      tag: '席位昂贵',
      text: '团队席位费贵 + 外接插件，持有成本偏高',
    },
    squarespace: {
      score: '4.0',
      tag: '资费固定',
      text: '资费透明固定，但业务拓展后易遇天花板',
    },
  },
];

const comparisons = [
  {
    title: 'Wix vs Shopify 深度对比（2026）',
    target: 'Shopify',
    targetLogoColor: 'bg-emerald-50 text-emerald-600 border-emerald-200',
    slug: '/compare/wix-vs-shopify-2026/',
    summary: '外贸品牌出海选 Wix（0% 抽成+自由排版）；海量快消标品铺货选 Shopify。',
    verdict: '外贸 B2B 品牌出海、工厂定制与精品 DTC 首选 Wix；数万款快消大宗标品铺货选 Shopify。',
    wixStrengths: [
      '等比流体引擎，像素级非标视觉自由',
      '0% 额外平台抽佣，仅收网关原生费率',
      '商城、预约、会员、CMS 原生闭环免购 App',
      'B2B 验厂信任设计，多维度背书企业实力',
    ],
    competitorStrengths: [
      '海量快消标品 SKU 铺货与分销成熟',
      '重度仓储物流与 ERP 自动化接口丰富',
    ],
    score: '9.5',
    rank: 'WIX 胜出（品牌出海与综合展示）',
  },
  {
    title: 'Wix vs WordPress 深度对比（2026）',
    target: 'WordPress',
    targetLogoColor: 'bg-blue-50 text-blue-600 border-blue-200',
    slug: '/compare/wix-vs-wordpress-2026/',
    summary: '追求全托管省心免运维选 Wix；掌控底层源码数据库选 WordPress。',
    verdict: '告别服务器宕机、插件漏洞挂马与冲突白屏，专注核心业务首选 Wix；需自建内网选 WordPress。',
    wixStrengths: [
      '全托管云端架构，免配服务器与 CDN 节点',
      '官方统一安全防护，根绝插件漏洞挂马',
      '原生纯净渲染，无 Elementor 等代码臃肿',
      '大幅降低 TCO，年均省数万元维护工时',
    ],
    competitorStrengths: [
      '源码与底层数据库完全开源私有化',
      '全球庞大的开源插件与主题市场',
    ],
    score: '9.4',
    rank: 'WIX 胜出（企业省心与免运维）',
  },
  {
    title: 'Wix Studio vs Webflow 深度对比（2026）',
    target: 'Webflow',
    targetLogoColor: 'bg-indigo-50 text-indigo-600 border-indigo-200',
    slug: '/compare/wix-vs-webflow-2026/',
    summary: '商业生态与交付效率选 Wix Studio；精通手写 CSS 纯展示选 Webflow。',
    verdict: '追求前沿视觉且需成熟商业闭环首选 Wix Studio；仅做纯静态展示且精通手写 CSS 选 Webflow。',
    wixStrengths: [
      '原生全套商业应用闭环，无需 Zapier 拼装',
      '等比流体缩放与 9 点停靠，交付提速 40%+',
      'Velo 原生全栈 JS：支持后端 Serverless 与 API',
      '官方中文环境与本土化出海支持体系',
    ],
    competitorStrengths: [
      '严格遵循标准 CSS 盒模型与 Class 继承',
      '支持导出纯静态 HTML/CSS 代码',
    ],
    score: '9.6',
    rank: 'WIX 胜出（商业落地与交付效率）',
  },
  {
    title: 'Wix vs Squarespace 深度对比（2026）',
    target: 'Squarespace',
    targetLogoColor: 'bg-zinc-100 text-zinc-800 border-zinc-300',
    slug: '/compare/wix-vs-squarespace-2026/',
    summary: '深度定制与商业扩展选 Wix；极简模板图文替换选 Squarespace。',
    verdict: '非标定制品牌站、全渠道扩展与深度出海首选 Wix；极简图文个人作品集选 Squarespace。',
    wixStrengths: [
      '自由流体排版，打破固定模块栅格限制',
      '丰富微交互动效与原生 CSS 深度控制',
      '原生出海多语言支持与双引擎 SEO 收录',
      '无代码到全代码平滑进阶，业务无天花板',
    ],
    competitorStrengths: [
      '摄影模板审美质感高，不易排版出错',
      '界面克制极简，适合轻量个人作品集',
    ],
    score: '9.3',
    rank: 'WIX 胜出（定制自由度与功能深度）',
  },
];
---

<BaseLayout
  title="主流建站平台横评指南（2026）| Wix vs Shopify / WordPress / Webflow - wixstudio.cn"
  description="2026最新主流建站平台全方位横评。以 Wix Studio 为核心基准，从设计自由度、商业生态、平台抽成、免运维安全、代码扩展与 TCO 等维度深入对比，助您做对技术选型。"
  keywords="建站平台对比, Wix vs Shopify, Wix vs WordPress, Wix vs Webflow, 最好的建站工具, 外贸建站哪个好, Wix Studio 优势"
>
  <HeroListing
    label="Platform Comparison · 平台客观横评（Wix 优先评估）"
    title="主流建站平台全方位深度横评（2026）"
    subtitle="基于客观实测数据与商业落地实践。以 Wix / Wix Studio 为核心坐标，深度剖析在排版自由度、商业闭环、交易抽成、免运维安全与综合 TCO 等关键维度的全景对比。"
    stats={[
      { value: '6 大', label: '核心评估维度' },
      { value: '4 组', label: '主流平台深度对决' },
      { value: '0%', label: 'Wix 额外交易佣金' },
      { value: '2026', label: '最新版本基准' },
    ]}
  />

  <main class="bg-gray-50/50 py-12 lg:py-16 space-y-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">

      <!-- Section: Global Dimension Evaluation Matrix -->
      <section class="bg-white rounded-3xl border border-gray-200/90 p-6 sm:p-8 shadow-sm space-y-6">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-gray-150 pb-5">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-[#116DFF] text-xs font-bold border border-blue-100 mb-2">
              <Icon name="sparkles" class="w-3.5 h-3.5" />
              <span>全景雷达矩阵 · 核心维度评估（Wix 优先）</span>
            </div>
            <h2 class="text-2xl font-black text-gray-900 tracking-tight">主流建站平台 6 大核心维度总览表</h2>
            <p class="text-xs sm:text-sm text-gray-500 mt-1">
              全方位对比 Wix Studio 与主流竞品的技术底层、商业模型与长期维护成本
            </p>
          </div>
          <div class="text-xs text-gray-400 font-medium shrink-0">
            评测基准：2026 年最新稳定版本
          </div>
        </div>

        <!-- Modern SaaS Comparison Table -->
        <div class="overflow-x-auto rounded-2xl border border-gray-200/80 shadow-xs">
          <table class="w-full min-w-[1000px] text-left border-collapse table-fixed">
            <thead>
              <tr class="border-b border-gray-200 bg-gray-50/80 text-xs">
                <th class="py-3 px-3.5 sm:px-4 w-[18%] font-bold text-gray-500 uppercase tracking-wider">
                  评估维度
                </th>
                <!-- Wix Studio Column Header (Highlighted) -->
                <th class="py-3.5 px-3.5 sm:px-4 w-[26%] bg-[#116DFF] text-white border-x-2 border-blue-600 shadow-sm">
                  <div class="flex items-center justify-between gap-2">
                    <span class="font-black text-sm tracking-wide flex items-center gap-1.5 whitespace-nowrap">
                      Wix / Wix Studio
                    </span>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-white text-[#116DFF] whitespace-nowrap">
                      推荐首选
                    </span>
                  </div>
                  <div class="text-[11px] text-blue-100 font-medium mt-0.5">
                    全功能 · 0% 平台抽成 · 免运维
                  </div>
                </th>
                <!-- Competitor Headers -->
                <th class="py-3 px-3.5 sm:px-4 w-[14%] bg-gray-50 border-r border-gray-200">
                  <div class="text-sm font-bold text-emerald-800">Shopify</div>
                  <div class="text-[11px] text-emerald-600/80">标品快消电商</div>
                </th>
                <th class="py-3 px-3.5 sm:px-4 w-[14%] bg-gray-50 border-r border-gray-200">
                  <div class="text-sm font-bold text-blue-900">WordPress</div>
                  <div class="text-[11px] text-blue-700/80">开源自托管 CMS</div>
                </th>
                <th class="py-3 px-3.5 sm:px-4 w-[14%] bg-gray-50 border-r border-gray-200">
                  <div class="text-sm font-bold text-indigo-900">Webflow</div>
                  <div class="text-[11px] text-indigo-700/80">纯前端 CSS 盒模型</div>
                </th>
                <th class="py-3 px-3.5 sm:px-4 w-[14%] bg-gray-50">
                  <div class="text-sm font-bold text-zinc-800">Squarespace</div>
                  <div class="text-[11px] text-zinc-500">固定栅格模板</div>
                </th>
              </tr>
            </thead>

            <tbody class="divide-y divide-gray-150 text-xs">
              {dimensionMatrix.map((row, idx) => (
                <tr class={idx % 2 === 0 ? 'bg-white hover:bg-slate-50/50 transition-colors' : 'bg-slate-50/30 hover:bg-slate-50/70 transition-colors'}>
                  <!-- Dimension Column -->
                  <td class="py-3 px-3.5 sm:px-4 align-top">
                    <div class="font-bold text-gray-900 text-xs sm:text-sm leading-snug">{row.dimension}</div>
                    <div class="text-[11px] text-[#116DFF] font-medium mt-1 leading-snug">
                      {row.advantage}
                    </div>
                  </td>

                  <!-- Wix Column (Elevated) -->
                  <td class="py-3 px-3.5 sm:px-4 bg-blue-50/50 border-x-2 border-blue-500/25 align-top">
                    <div class="space-y-1">
                      <div class="flex items-center gap-1.5">
                        <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded bg-[#116DFF] text-white text-[10px] font-bold font-mono">
                          <Icon name="star" class="w-3 h-3 text-amber-300 fill-amber-300" />
                          <span>{row.wix.score}</span>
                        </span>
                        <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-blue-100 text-[#116DFF]">
                          {row.wix.tag}
                        </span>
                      </div>
                      <div class="text-xs font-bold text-gray-900 leading-snug">{row.wix.text}</div>
                    </div>
                  </td>

                  <!-- Shopify Column -->
                  <td class="py-3 px-3.5 sm:px-4 border-r border-gray-150 align-top">
                    <div class="space-y-1">
                      <div class="flex items-center gap-1.5">
                        <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded bg-slate-100 text-slate-700 text-[10px] font-bold font-mono">
                          <Icon name="star" class="w-3 h-3 text-amber-400 fill-amber-400" />
                          <span>{row.shopify.score}</span>
                        </span>
                        <span class="text-[10px] font-medium px-1.5 py-0.5 rounded bg-slate-100 text-slate-600">
                          {row.shopify.tag}
                        </span>
                      </div>
                      <div class="text-xs text-gray-700 leading-snug">{row.shopify.text}</div>
                    </div>
                  </td>

                  <!-- WordPress Column -->
                  <td class="py-3 px-3.5 sm:px-4 border-r border-gray-150 align-top">
                    <div class="space-y-1">
                      <div class="flex items-center gap-1.5">
                        <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded bg-slate-100 text-slate-700 text-[10px] font-bold font-mono">
                          <Icon name="star" class="w-3 h-3 text-amber-400 fill-amber-400" />
                          <span>{row.wordpress.score}</span>
                        </span>
                        <span class="text-[10px] font-medium px-1.5 py-0.5 rounded bg-slate-100 text-slate-600">
                          {row.wordpress.tag}
                        </span>
                      </div>
                      <div class="text-xs text-gray-700 leading-snug">{row.wordpress.text}</div>
                    </div>
                  </td>

                  <!-- Webflow Column -->
                  <td class="py-3 px-3.5 sm:px-4 border-r border-gray-150 align-top">
                    <div class="space-y-1">
                      <div class="flex items-center gap-1.5">
                        <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded bg-slate-100 text-slate-700 text-[10px] font-bold font-mono">
                          <Icon name="star" class="w-3 h-3 text-amber-400 fill-amber-400" />
                          <span>{row.webflow.score}</span>
                        </span>
                        <span class="text-[10px] font-medium px-1.5 py-0.5 rounded bg-slate-100 text-slate-600">
                          {row.webflow.tag}
                        </span>
                      </div>
                      <div class="text-xs text-gray-700 leading-snug">{row.webflow.text}</div>
                    </div>
                  </td>

                  <!-- Squarespace Column -->
                  <td class="py-3 px-3.5 sm:px-4 align-top">
                    <div class="space-y-1">
                      <div class="flex items-center gap-1.5">
                        <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded bg-slate-100 text-slate-700 text-[10px] font-bold font-mono">
                          <Icon name="star" class="w-3 h-3 text-amber-400 fill-amber-400" />
                          <span>{row.squarespace.score}</span>
                        </span>
                        <span class="text-[10px] font-medium px-1.5 py-0.5 rounded bg-slate-100 text-slate-600">
                          {row.squarespace.tag}
                        </span>
                      </div>
                      <div class="text-xs text-gray-700 leading-snug">{row.squarespace.text}</div>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section: Detailed Platform Cards -->
      <section class="space-y-6">
        <div class="flex items-center justify-between pb-2">
          <h3 class="text-xl font-black text-gray-900 tracking-tight">各平台深度对决与适用场景拆解</h3>
          <span class="text-xs text-gray-400">点击进入长篇深度评测报告</span>
        </div>

        <div class="space-y-6">
          {comparisons.map((item, index) => (
            <article class="group bg-white rounded-3xl border border-gray-200/90 overflow-hidden card-lift card-glow transition-all duration-300">
              <!-- Header bar -->
              <div class="p-6 sm:p-8 flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-gray-100/80 bg-gradient-to-r from-gray-50/50 via-white to-blue-50/30">
                <div class="space-y-1.5">
                  <div class="flex items-center gap-2.5">
                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-[#116DFF]/10 text-[#116DFF] border border-[#116DFF]/20">
                      深度对决 0{index + 1}
                    </span>
                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                      {item.rank}
                    </span>
                    <span class="text-xs text-gray-400 font-medium">评分：{item.score} / 10</span>
                  </div>
                  <h2 class="text-2xl font-black text-gray-900 group-hover:text-[#116DFF] transition-colors leading-tight">
                    <a href={item.slug}>{item.title}</a>
                  </h2>
                  <p class="text-xs sm:text-sm text-gray-500">{item.summary}</p>
                </div>

                <div class="flex items-center gap-3 shrink-0 pt-2 md:pt-0">
                  <a
                    href={item.slug}
                    class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs font-semibold text-white bg-[#116DFF] hover:bg-[#0D5FE3] shadow-md shadow-blue-500/20 active:scale-95 transition-all"
                  >
                    <span>阅读完整深度横评</span>
                    <Icon name="arrow-right" class="w-3.5 h-3.5" />
                  </a>
                </div>
              </div>

              <!-- Body content -->
              <div class="p-6 sm:p-8 space-y-6">
                <!-- Verdict Banner -->
                <div class="p-4 rounded-2xl bg-[#116DFF]/5 border border-[#116DFF]/15 text-xs sm:text-sm text-gray-800 flex items-start gap-3">
                  <div class="w-7 h-7 rounded-xl bg-[#116DFF] text-white flex items-center justify-center shrink-0 mt-0.5 shadow-xs">
                    <Icon name="sparkles" class="w-3.5 h-3.5" />
                  </div>
                  <div>
                    <span class="font-bold text-[#116DFF] mr-1">选型结论速览：</span>
                    <span class="leading-relaxed text-gray-700">{item.verdict}</span>
                  </div>
                </div>

                <!-- Two column comparison details -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                  <!-- Wix Advantages (Highlighted) -->
                  <div class="p-5 rounded-2xl bg-gradient-to-br from-blue-50/60 via-white to-indigo-50/20 border border-blue-200/70 space-y-3">
                    <div class="flex items-center justify-between">
                      <span class="font-bold text-xs uppercase tracking-wider text-[#116DFF] flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-[#116DFF]"></span>
                        Wix / Wix Studio 核心优势
                      </span>
                      <span class="text-[11px] font-bold px-2 py-0.5 rounded-md bg-blue-100 text-[#116DFF]">
                        核心胜出点
                      </span>
                    </div>
                    <ul class="space-y-2 text-xs sm:text-sm text-gray-700">
                      {item.wixStrengths.map((s) => (
                        <li class="flex items-start gap-2">
                          <div class="w-4 h-4 rounded-full bg-blue-100 text-[#116DFF] flex items-center justify-center shrink-0 mt-0.5">
                            <Icon name="check" class="w-2.5 h-2.5" />
                          </div>
                          <span class="leading-relaxed">{s}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <!-- Competitor Focus -->
                  <div class="p-5 rounded-2xl bg-gray-50/80 border border-gray-200/80 space-y-3">
                    <div class="flex items-center justify-between">
                      <span class="font-bold text-xs uppercase tracking-wider text-gray-600 flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-gray-400"></span>
                        {item.target} 适用边界与考量
                      </span>
                      <span class="text-[11px] font-medium px-2 py-0.5 rounded-md bg-white border border-gray-200 text-gray-500">
                        特定垂直场景
                      </span>
                    </div>
                    <ul class="space-y-2 text-xs sm:text-sm text-gray-600">
                      {item.competitorStrengths.map((s) => (
                        <li class="flex items-start gap-2">
                          <span class="w-1.5 h-1.5 rounded-full bg-gray-400 shrink-0 mt-2"></span>
                          <span class="leading-relaxed">{s}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Section: 3-Second Decision Guide Banner -->
      <section class="rounded-3xl p-8 sm:p-10 bg-gradient-to-r from-slate-900 via-[#0B1528] to-slate-900 text-white border border-slate-800 shadow-xl space-y-6">
        <div class="max-w-3xl space-y-2">
          <span class="text-xs font-bold tracking-widest text-[#4A90E2] uppercase">DECISION FRAMEWORK</span>
          <h3 class="text-2xl sm:text-3xl font-black tracking-tight text-white">如何 3 秒做出最理性的建站选型？</h3>
          <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
            建站工具的核心不是“哪一个最强”，而是“哪一个最能适配您的商业模式并以最低成本交付落地”。
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 pt-2">
          <div class="p-4 rounded-2xl bg-white/5 border border-white/10 space-y-1.5">
            <div class="text-xs font-bold text-[#4A90E2]">外贸 B2B 品牌出海</div>
            <div class="text-sm font-black text-white">首选 Wix Studio</div>
            <p class="text-xs text-slate-400">工厂实力背书、定制展示、0抽成与多语言 SEO 完备。</p>
          </div>
          <div class="p-4 rounded-2xl bg-white/5 border border-white/10 space-y-1.5">
            <div class="text-xs font-bold text-emerald-400">海量 SKU 铺货零售</div>
            <div class="text-sm font-black text-white">首选 Shopify</div>
            <p class="text-xs text-slate-400">数千款标品高频买卖、重度分销与仓储物流 API 联动。</p>
          </div>
          <div class="p-4 rounded-2xl bg-white/5 border border-white/10 space-y-1.5">
            <div class="text-xs font-bold text-violet-400">高端设计与商业变现</div>
            <div class="text-sm font-black text-white">首选 Wix Studio</div>
            <p class="text-xs text-slate-400">流体排版视觉惊艳，原生商城/预约/会员闭环极速交付。</p>
          </div>
          <div class="p-4 rounded-2xl bg-white/5 border border-white/10 space-y-1.5">
            <div class="text-xs font-bold text-amber-400">企业级省心免运维</div>
            <div class="text-sm font-black text-white">首选 Wix</div>
            <p class="text-xs text-slate-400">彻底告别 WordPress 频繁被黑、漏洞挂马与宕机维护噩梦。</p>
          </div>
        </div>

        <div class="pt-4 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-white/10">
          <div class="text-xs text-slate-400">
            还在犹豫不决？联系 Wix 官方 Legend 合作伙伴为您提供 1 对 1 技术架构选型评估。
          </div>
          <a
            href="/contact/"
            class="px-6 py-2.5 rounded-full bg-[#116DFF] hover:bg-[#0D5FE3] text-white text-xs font-bold tracking-wide transition shadow-lg shrink-0"
          >
            免费获取选型建议 →
          </a>
        </div>
      </section>

    </div>
  </main>
</BaseLayout>
