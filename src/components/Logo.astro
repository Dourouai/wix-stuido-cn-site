---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { size = 'md', class: className = '' } = Astro.props;

const sizes = {
  sm: 'text-lg',
  md: 'text-2xl',
  lg: 'text-3xl sm:text-4xl',
};

const currentSize = sizes[size];
---

<div class={`inline-flex items-baseline tracking-tight select-none font-sans group ${className}`}>
  <span class={`font-black text-[#0F172A] ${currentSize} tracking-tight group-hover:opacity-90 transition`}>
    wixstudio
  </span>
  <span class={`font-black text-[#6D28D9] ${currentSize} tracking-tight group-hover:text-[#7C3AED] transition`}>
    .cn
  </span>
</div>
