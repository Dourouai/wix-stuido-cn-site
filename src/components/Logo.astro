---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  showText?: boolean;
  class?: string;
}

const { size = 'md', showText = true, class: className = '' } = Astro.props;

const sizes = {
  sm: { icon: 'w-6 h-6', text: 'text-lg', dot: 'text-xs' },
  md: { icon: 'w-8 h-8', text: 'text-2xl', dot: 'text-sm' },
  lg: { icon: 'w-10 h-10', text: 'text-3xl', dot: 'text-base' },
};

const currentSize = sizes[size];
---

<div class={`flex items-center gap-2.5 select-none ${className}`}>
  <!-- Fluid W+S Emblem Icon -->
  <svg
    class={`${currentSize.icon} shrink-0 transition-transform duration-300 group-hover:scale-105`}
    viewBox="0 0 48 40"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="wixstudioLogoGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#8B5CF6" />
        <stop offset="50%" stop-color="#6D28D9" />
        <stop offset="100%" stop-color="#2563EB" />
      </linearGradient>
      <filter id="logoGlow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="1.5" result="blur" />
        <feComposite in="SourceGraphic" in2="blur" operator="over" />
      </filter>
    </defs>

    <!-- Outer W Left Wing -->
    <path
      d="M 6 12 C 6 6, 12 4, 15 10 L 20 22 C 21 24, 23 24, 24 22 L 28 14 C 29 12, 32 12, 33 14 L 37 24 C 38 26, 40 26, 41 24 L 44 14 C 45 10, 48 10, 48 14 L 43 28 C 41 33, 36 34, 33 30 L 29 22 C 28 20, 26 20, 25 22 L 21 31 C 18 36, 11 36, 8 28 Z"
      fill="url(#wixstudioLogoGrad)"
      opacity="0.18"
    />

    <!-- Fluid Continuous W+S Ribbon Path -->
    <path
      d="M 6 14 C 6 8, 12 6, 15 12 L 20 24 C 21.5 27, 25 27, 26.5 24 L 29.5 17 C 30.5 15, 33 15, 34 17 L 37 25 C 38.5 28, 41.5 28, 43 25 L 45 15 C 46 11, 48 13, 47 17 L 43.5 28 C 40.5 35, 35 35, 32 30 L 29 23 C 28 21, 26 21, 25 23 L 22 29 C 19 35, 12 35, 9 28 L 5 18 C 4 16, 5 14, 6 14 Z"
      fill="url(#wixstudioLogoGrad)"
    />

    <!-- Intertwined Center S Loop Accent -->
    <path
      d="M 23 11 C 20 11, 19 13.5, 20.5 16 C 22 18.5, 27 19.5, 27.5 22.5 C 28 25.5, 24.5 27.5, 21.5 26"
      stroke="#FFFFFF"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      opacity="0.95"
    />
  </svg>

  {showText && (
    <div class="flex items-baseline tracking-tight">
      <span class={`font-black text-[#0F172A] ${currentSize.text} tracking-tight`}>wixstudio</span>
      <span class={`font-black text-[#6D28D9] ${currentSize.text} tracking-tight`}>.cn</span>
    </div>
  )}
</div>
