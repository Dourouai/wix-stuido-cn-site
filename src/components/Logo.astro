---
interface Props {
  size?: 'xs' | 'sm' | 'md' | 'lg';
  class?: string;
}

const { size = 'md', class: className = '' } = Astro.props;

// 纤巧精致微调：降低高度，与导航文字（14px）及按钮比例和谐，视觉更精致轻盈
const heights = {
  xs: 'h-3.5 sm:h-4',
  sm: 'h-4 sm:h-[18px]',
  md: 'h-[18px] sm:h-[20px]',
  lg: 'h-6 sm:h-7',
};

const currentHeight = heights[size];
---

<div class={`inline-flex items-center select-none group ${className}`}>
  <img
    src="/logo.svg"
    alt="Wix Studio 中文网"
    class={`${currentHeight} w-auto object-contain transition-opacity duration-200 group-hover:opacity-85`}
    loading="eager"
  />
</div>
