---
/**
 * HeroMarketing — 产品/营销型 Hero
 * 用于：Studio 介绍、套餐价格、联系页
 * 特征：居中排版 + 标题 + 副标题 + 可选 CTA 按钮
 */

interface CTA {
  text: string;
  href: string;
  primary?: boolean;
}

interface Props {
  /** 顶部小标签 */
  label?: string;
  /** 页面主标题 */
  title: string;
  /** 副标题 */
  subtitle?: string;
  /** CTA 按钮（最多2个） */
  actions?: CTA[];
}

const { label, title, subtitle, actions } = Astro.props;
---

<section class="relative overflow-hidden bg-gradient-to-b from-[#F0F4FF] to-white border-b border-gray-100">
  <!-- 背景纹理 -->
  <div class="absolute inset-0 opacity-25 pointer-events-none"
       style="background-image: radial-gradient(circle, #C7D2FE 1px, transparent 1px); background-size: 32px 32px;"></div>
  <!-- 渐变光晕 -->
  <div class="absolute top-[-100px] left-1/2 -translate-x-1/2 w-[600px] h-[300px] rounded-full pointer-events-none"
       style="background: radial-gradient(ellipse, rgba(17,109,255,0.06) 0%, transparent 70%);"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-12 py-16 lg:py-24 relative text-center">
    <div class="max-w-2xl mx-auto">

      {label && (
        <p class="text-[13px] font-semibold text-[#116DFF] tracking-widest uppercase mb-3 hero-enter hero-enter-d1">
          {label}
        </p>
      )}

      <h1 class="text-3xl sm:text-[44px] font-black text-gray-900 tracking-tight leading-tight mb-4 hero-enter hero-enter-d2"
          style="font-family: 'Inter', 'Noto Sans SC', 'PingFang SC', system-ui, sans-serif;">
        {title}
      </h1>

      {subtitle && (
        <p class="text-[17px] text-gray-400 leading-relaxed mb-8 hero-enter hero-enter-d3">
          {subtitle}
        </p>
      )}

      {actions && actions.length > 0 && (
        <div class="flex flex-wrap justify-center gap-3 hero-enter hero-enter-d4">
          {actions.map(a => (
            <a href={a.href}
               class={`inline-flex items-center gap-2 px-7 py-3 rounded-full text-[14px] font-semibold transition-all duration-200 active:scale-[0.97] ${
                 a.primary
                   ? 'text-white bg-[#116DFF] hover:bg-[#0D5FE3] shadow-lg shadow-blue-500/20'
                   : 'text-gray-600 border border-gray-200 bg-white hover:border-gray-300 hover:bg-gray-50 shadow-sm'
               }`}>
              {a.text}
              {a.primary && (
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              )}
            </a>
          ))}
        </div>
      )}

    </div>

    <slot />
  </div>
</section>
