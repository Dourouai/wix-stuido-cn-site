---
import Logo from './Logo.astro';

const currentPath = Astro.url.pathname;

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'Studio', href: '/studio/' },
  {
    name: 'Tutorials',
    href: '/tutorials/',
    dropdown: [
      { name: '📘 Getting Started', desc: '从零开始注册与首个站点搭建', href: '/tutorials/getting-started/' },
      { name: '🎨 Design & Layout', desc: '流体网格、断点与响应式设计', href: '/tutorials/design/' },
      { name: '💻 Velo Dev', desc: 'JavaScript代码扩展与全端动态CMS', href: '/tutorials/velo/' },
      { name: '🔍 SEO Guide', desc: '百度与Google双引擎收录排名优化', href: '/tutorials/seo/' },
      { name: '🛒 E-Commerce', desc: '外贸商城搭建与国际金流支付设置', href: '/tutorials/ecommerce/' },
    ],
  },
  {
    name: 'Compare',
    href: '/compare/',
    dropdown: [
      { name: 'Wix vs Shopify', desc: '外贸商城与独立站深度对决', href: '/compare/wix-vs-shopify/' },
      { name: 'Wix vs WordPress', desc: '现代SaaS与开源CMS终极选型', href: '/compare/wix-vs-wordpress/' },
      { name: 'Wix vs Webflow', desc: '设计师高端建站平台对比', href: '/compare/wix-vs-webflow/' },
      { name: 'Wix vs Squarespace', desc: '极简视觉美学建站对比', href: '/compare/wix-vs-squarespace/' },
      { name: 'All Comparisons →', desc: '查看完整建站平台横评指南', href: '/compare/' },
    ],
  },
  { name: 'Pricing', href: '/pricing/' },
  { name: 'Blog', href: '/blog/' },
];
---

<header class="sticky top-0 z-50 w-full bg-white/85 backdrop-blur-xl border-b border-gray-200/80 transition-all shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 flex items-center justify-between">
    <!-- Brand Logo with New Emblem -->
    <a href="/" class="flex items-center gap-3 group transition">
      <Logo size="md" />
      <div class="hidden sm:inline-flex items-center gap-1.5 text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-purple-50 text-[#6D28D9] border border-purple-100 group-hover:border-purple-200 transition">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>中文站</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-1">
      {navLinks.map((item) => (
        item.dropdown ? (
          <div class="relative group">
            <button
              class={`px-3.5 py-2 rounded-full text-sm font-medium transition-colors flex items-center gap-1.5 cursor-pointer ${
                currentPath.startsWith(item.href)
                  ? 'text-[#6D28D9] bg-purple-50 font-semibold'
                  : 'text-gray-600 hover:text-gray-900 hover:bg-gray-100/80'
              }`}
            >
              <span>{item.name}</span>
              <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180 text-gray-400 group-hover:text-gray-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <!-- Dropdown Menu with Crisp Light Glassmorphism -->
            <div class="absolute left-0 mt-2 w-72 p-2 bg-white border border-gray-200/90 rounded-2xl shadow-xl shadow-gray-200/70 backdrop-blur-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 translate-y-2 group-hover:translate-y-0">
              {item.dropdown.map((subItem) => (
                <a
                  href={subItem.href}
                  class="block p-2.5 rounded-xl hover:bg-purple-50/70 transition group/item"
                >
                  <div class="text-sm font-medium text-gray-800 group-hover/item:text-[#6D28D9] transition flex items-center justify-between">
                    <span>{subItem.name}</span>
                  </div>
                  <div class="text-xs text-gray-500 mt-0.5 line-clamp-1">{subItem.desc}</div>
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class={`px-3.5 py-2 rounded-full text-sm font-medium transition-colors ${
              currentPath === item.href
                ? 'text-[#6D28D9] bg-purple-50 font-semibold'
                : 'text-gray-600 hover:text-gray-900 hover:bg-gray-100/80'
            }`}
          >
            {item.name}
          </a>
        )
      ))}
    </nav>

    <!-- Right Actions -->
    <div class="hidden sm:flex items-center gap-3">
      <a
        href="/contact/"
        class="btn-primary-glow inline-flex items-center gap-1.5 px-5 py-2 rounded-full text-sm font-semibold text-white bg-gradient-to-r from-[#6D28D9] to-[#2563EB] shadow-md shadow-purple-500/20 active:scale-95 transition"
      >
        <span>Get Started</span>
        <svg class="w-3.5 h-3.5 transform group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Mobile Menu Hamburger Button -->
    <div class="flex lg:hidden items-center">
      <button
        id="mobile-menu-btn"
        aria-label="Toggle menu"
        class="p-2 rounded-xl text-gray-600 hover:text-gray-900 hover:bg-gray-100 transition"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-200 bg-white/98 backdrop-blur-2xl px-4 pt-4 pb-6 space-y-1 shadow-xl">
    {navLinks.map((item) => (
      item.dropdown ? (
        <div class="py-1">
          <div class="px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-gray-400">{item.name}</div>
          <div class="pl-2 space-y-1">
            {item.dropdown.map((subItem) => (
              <a
                href={subItem.href}
                class="block px-3 py-2 rounded-lg text-sm text-gray-700 hover:text-[#6D28D9] hover:bg-purple-50"
              >
                {subItem.name}
              </a>
            ))}
          </div>
        </div>
      ) : (
        <a
          href={item.href}
          class="block px-3 py-2 rounded-lg text-sm font-medium text-gray-800 hover:text-[#6D28D9] hover:bg-purple-50"
        >
          {item.name}
        </a>
      )
    ))}
    <div class="pt-4 mt-2 border-t border-gray-100">
      <a
        href="/contact/"
        class="w-full inline-flex items-center justify-center gap-2 px-4 py-3 rounded-full text-sm font-semibold text-white bg-gradient-to-r from-[#6D28D9] to-[#2563EB] shadow-md"
      >
        <span>Get Started</span>
        <span>→</span>
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger-icon');
  const close = document.getElementById('close-icon');

  if (btn && menu && hamburger && close) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
      hamburger.classList.toggle('hidden');
      close.classList.toggle('hidden');
    });
  }
</script>
