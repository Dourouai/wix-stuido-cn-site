---
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const currentPath = Astro.url.pathname;

const navLinks = [
  { name: '首页', href: '/' },
  { name: 'Studio 介绍', href: '/studio/' },
  {
    name: '教程中心',
    href: '/tutorials/',
    dropdown: [
      { name: '新手入门实战', icon: 'book-open', desc: '从零开始注册与首个站点搭建', href: '/tutorials/getting-started/' },
      { name: '设计与流体排版', icon: 'palette', desc: '流体网格、断点与响应式设计', href: '/tutorials/design/' },
      { name: 'Velo 全栈开发', icon: 'code', desc: 'JavaScript代码扩展与全端动态CMS', href: '/tutorials/velo/' },
      { name: 'SEO 优化与收录', icon: 'search', desc: '百度与Google双引擎收录排名优化', href: '/tutorials/seo/' },
      { name: '外贸独立站与商城', icon: 'shopping-bag', desc: '外贸商城搭建与国际金流支付设置', href: '/tutorials/ecommerce/' },
    ],
  },
  {
    name: '平台横评',
    href: '/compare/',
    dropdown: [
      { name: 'Wix vs Shopify', icon: 'scale', desc: '外贸商城与独立站深度对决', href: '/compare/wix-vs-shopify-2026/' },
      { name: 'Wix vs WordPress', icon: 'scale', desc: '现代SaaS与开源CMS终极选型', href: '/compare/wix-vs-wordpress-2026/' },
      { name: 'Wix vs Webflow', icon: 'scale', desc: '设计师高端建站平台对比', href: '/compare/wix-vs-webflow-2026/' },
      { name: 'Wix vs Squarespace', icon: 'scale', desc: '极简视觉美学建站对比', href: '/compare/wix-vs-squarespace-2026/' },
      { name: '查看全部横评报告 →', icon: 'sparkles', desc: '查看完整建站平台横评指南', href: '/compare/' },
    ],
  },
  { name: '套餐价格', href: '/pricing/' },
  { name: '博客资讯', href: '/blog/' },
];
---

<header id="site-navbar" class="fixed top-0 z-50 w-full navbar-transparent transition-all duration-300 border-b">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-18 flex items-center justify-between">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group transition py-1">
      <Logo size="md" />
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-0.5">
      {navLinks.map((item) => (
        item.dropdown ? (
          <div class="relative group">
            <a
              href={item.href}
              class={`px-3.5 py-2 rounded-lg text-sm font-medium transition-colors flex items-center gap-1.5 cursor-pointer ${
                currentPath.startsWith(item.href)
                  ? 'text-[#116DFF] bg-[#116DFF]/8 font-semibold'
                  : 'text-gray-500 hover:text-gray-900 hover:bg-gray-100/80'
              }`}
            >
              <span>{item.name}</span>
              <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </a>

            <!-- Dropdown -->
            <div class="absolute left-0 mt-1.5 w-80 p-2 bg-white border border-gray-200 rounded-2xl shadow-xl shadow-black/[0.06] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 translate-y-2 group-hover:translate-y-0">
              {item.dropdown.map((subItem) => (
                <a
                  href={subItem.href}
                  class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-[#116DFF]/5 transition group/item"
                >
                  <div class="w-8 h-8 rounded-lg bg-gray-50 text-gray-400 flex items-center justify-center shrink-0 mt-0.5 border border-gray-100 group-hover/item:bg-[#116DFF] group-hover/item:text-white group-hover/item:border-[#116DFF] transition">
                    <Icon name={subItem.icon} class="w-4 h-4" />
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="text-sm font-semibold text-gray-900 group-hover/item:text-[#116DFF] transition">
                      {subItem.name}
                    </div>
                    <div class="text-xs text-gray-400 mt-0.5 line-clamp-1">{subItem.desc}</div>
                  </div>
                </a>
              ))}

              <!-- 进入汇总中心底部链接 -->
              <div class="pt-1.5 mt-1 border-t border-gray-100">
                <a
                  href={item.href}
                  class="flex items-center justify-between px-3 py-2 rounded-xl text-xs font-bold text-[#116DFF] hover:bg-[#116DFF]/8 transition"
                >
                  <span>进入完整{item.name}主页</span>
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class={`px-3.5 py-2 rounded-lg text-sm font-medium transition-colors ${
              currentPath === item.href
                ? 'text-[#116DFF] bg-[#116DFF]/8 font-semibold'
                : 'text-gray-500 hover:text-gray-900 hover:bg-gray-100/80'
            }`}
          >
            {item.name}
          </a>
        )
      ))}
    </nav>

    <!-- Right CTA -->
    <div class="hidden sm:flex items-center gap-3">
      <a
        href="/contact/"
        class="inline-flex items-center gap-1.5 px-5 py-2 rounded-full text-sm font-semibold text-white bg-[#116DFF] hover:bg-[#0D5FE3] shadow-md shadow-blue-500/15 active:scale-[0.97] transition-all"
      >
        <span>委托建站咨询</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Mobile hamburger -->
    <div class="flex lg:hidden items-center">
      <button
        id="mobile-menu-btn"
        aria-label="Toggle menu"
        class="p-2 rounded-xl text-gray-500 hover:text-gray-900 hover:bg-gray-100 transition"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-100 bg-white px-4 pt-4 pb-6 space-y-1">
    {navLinks.map((item) => (
      item.dropdown ? (
        <details class="group py-1">
          <summary class="flex items-center justify-between px-3 py-2 rounded-lg text-sm font-medium text-gray-900 hover:text-[#116DFF] hover:bg-[#116DFF]/5 cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none">
            <span>{item.name}</span>
            <svg class="w-4 h-4 text-gray-400 transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="pl-2 pt-1 pb-1 space-y-1">
            <a href={item.href} class="flex items-center justify-between px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-[#116DFF] hover:underline bg-[#116DFF]/5 rounded-md">
              <span>{item.name} 主页 →</span>
            </a>
            {item.dropdown.map((subItem) => (
              <a
                href={subItem.href}
                class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-gray-600 hover:text-[#116DFF] hover:bg-[#116DFF]/5"
              >
                <Icon name={subItem.icon} class="w-4 h-4 text-[#116DFF]" />
                <span>{subItem.name}</span>
              </a>
            ))}
          </div>
        </details>
      ) : (
        <a
          href={item.href}
          class="block px-3 py-2 rounded-lg text-sm font-medium text-gray-900 hover:text-[#116DFF] hover:bg-[#116DFF]/5"
        >
          {item.name}
        </a>
      )
    ))}
    <div class="pt-4 mt-2 border-t border-gray-100">
      <a
        href="/contact/"
        class="w-full inline-flex items-center justify-center gap-2 px-4 py-3 rounded-full text-sm font-semibold text-white bg-[#116DFF]"
      >
        <span>委托建站咨询</span>
        <span>→</span>
      </a>
    </div>
  </div>
</header>

<!-- 占位高度 -->
<div class="h-16 sm:h-18"></div>

<script>
  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger-icon');
  const close = document.getElementById('close-icon');

  if (btn && menu && hamburger && close) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
      hamburger.classList.toggle('hidden');
      close.classList.toggle('hidden');
    });
  }

  // Navbar scroll: transparent → solid
  const navbar = document.getElementById('site-navbar');
  if (navbar) {
    const update = () => {
      if (window.scrollY > 40) {
        navbar.classList.remove('navbar-transparent');
        navbar.classList.add('navbar-solid');
      } else {
        navbar.classList.remove('navbar-solid');
        navbar.classList.add('navbar-transparent');
      }
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>
